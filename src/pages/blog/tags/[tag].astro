---
import Layout from '../../../layouts/Layout.astro';
import BlogPost from '../../../components/blog/BlogPost.astro';
import Heading from '../../../components/ui/Heading.astro';
import { getPostsByTag } from '../../../lib/posts';

const { tag } = Astro.params;
const posts = tag ? await getPostsByTag(decodeURIComponent(tag)) : [];
---

<Layout pageTitle={tag ? `Postagens sobre ${tag}` : 'Tags'}>
    <section class="py-8">
        <div class="flex flex-col gap-8 max-w-4xl mx-auto">
            <Heading text="Postagens sobre" textGradient={tag}/>
            {
                posts.length > 0 ? (
                    posts.map((post) => (
                        <BlogPost
                            url={`/blog/posts/${post.slug}`}
                            title={post.title}
                            date={post.pub_date}
                            tags={post.tags}
                            languages={post.languages}
                            image={post.image_url ? { url: post.image_url, alt: post.image_alt || post.title } : undefined}
                        />
                    ))
                ) : (
                    <p class="text-center text-neutral-400 py-12">Nenhum post encontrado com esta tag.</p>
                )
            }
        </div>
    </section>
</Layout>
