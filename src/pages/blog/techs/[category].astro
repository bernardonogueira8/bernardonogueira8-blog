---
import Layout from "../../../layouts/Layout.astro";
import BlogPost from "../../../components/blog/BlogPost.astro";
import Heading from "../../../components/ui/Heading.astro";
import { getPostsByLanguage } from "../../../lib/posts";

const { category } = Astro.params;
const posts = category ? await getPostsByLanguage(decodeURIComponent(category)) : [];
---

<Layout pageTitle={category ? `Postagens sobre ${category}` : 'Tecnologias'}>
  <section class="py-8">
    <div class="flex flex-col gap-8 max-w-4xl mx-auto">
      <Heading text="Postagens sobre" textGradient={category} />

      {
        posts.length > 0 ? (
          posts.map((post) => (
            <BlogPost
              url={`/blog/posts/${post.slug}`}
              title={post.title}
              date={post.pub_date}
              tags={post.tags}
              languages={post.languages}
              image={post.image_url ? { url: post.image_url, alt: post.image_alt || post.title } : undefined}
            />
          ))
        ) : (
          <p class="text-center text-neutral-400 py-12">Nenhum post encontrado com esta tecnologia.</p>
        )
      }
    </div>
  </section>
</Layout>
