---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Painel Administrativo | Bernardo Studio";
---

<Layout pageTitle={pageTitle}>
  <div id="adminApp" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[90vh]">
    <!-- Apple-style Navigation Header -->
    <header class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-neutral-200/70 dark:border-white/10">
      <div class="flex items-center gap-3.5">
        <span class="inline-flex items-center justify-center size-11 rounded-2xl bg-[#0071e3] text-white font-extrabold text-lg shadow-sm shadow-[#0071e3]/20">
          BN
        </span>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#1d1d1f] dark:text-white tracking-tight flex items-center gap-2.5">
            Studio Administrativo
            <span class="text-[11px] px-2.5 py-0.5 rounded-full font-bold bg-[#0071e3]/10 text-[#0071e3] border border-[#0071e3]/20">
              Supabase CMS
            </span>
          </h1>
          <p id="userEmailBadge" class="text-xs text-[#86868b] dark:text-[#a1a1a6] font-medium">Verificando sessão de administrador...</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/"
          target="_blank"
          class="px-4 py-2 text-xs font-semibold rounded-full border border-neutral-300/80 dark:border-white/15 hover:bg-neutral-100 dark:hover:bg-white/5 text-[#1d1d1f] dark:text-white active:scale-[0.98] transition-all flex items-center gap-1.5"
        >
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver Site
        </a>
        <a
          href="/blog/"
          target="_blank"
          class="px-4 py-2 text-xs font-semibold rounded-full border border-neutral-300/80 dark:border-white/15 hover:bg-neutral-100 dark:hover:bg-white/5 text-[#1d1d1f] dark:text-white active:scale-[0.98] transition-all flex items-center gap-1.5"
        >
          Ver Blog
        </a>
        <button
          id="logoutBtn"
          class="px-4 py-2 text-xs font-semibold rounded-full border border-rose-500/20 text-rose-500 hover:bg-rose-500/10 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-1.5"
        >
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sair
        </button>
      </div>
    </header>

    <!-- Apple-style Segmented Control Menu Bar -->
    <nav class="my-6 p-1 bg-neutral-100 dark:bg-zinc-800/80 rounded-2xl flex items-center gap-1 overflow-x-auto scrollbar-none border border-neutral-200/60 dark:border-white/5" aria-label="Menu Administrativo">
      <button
        type="button"
        data-tab="posts"
        class="admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs"
      >
        <span>📝</span>
        <span>Posts & Blog</span>
        <span id="tabCountPosts" class="ml-1 px-1.5 py-0.5 rounded-md text-[10px] bg-neutral-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 font-bold">-</span>
      </button>

      <button
        type="button"
        data-tab="profile"
        class="admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white"
      >
        <span>👤</span>
        <span>Perfil & Links</span>
      </button>

      <button
        type="button"
        data-tab="experiences"
        class="admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white"
      >
        <span>💼</span>
        <span>Experiências</span>
        <span id="tabCountExperiences" class="ml-1 px-1.5 py-0.5 rounded-md text-[10px] bg-neutral-200 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 font-bold">-</span>
      </button>

      <button
        type="button"
        data-tab="tech-stack"
        class="admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white"
      >
        <span>⚡</span>
        <span>Tech Stack</span>
        <span id="tabCountTech" class="ml-1 px-1.5 py-0.5 rounded-md text-[10px] bg-neutral-200 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 font-bold">-</span>
      </button>

      <button
        type="button"
        data-tab="about"
        class="admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white"
      >
        <span>📖</span>
        <span>Sobre Mim</span>
      </button>
    </nav>

    <!-- Global Floating Toast Notification -->
    <div id="toastMessage" class="hidden fixed bottom-6 right-6 z-50 px-5 py-3 rounded-2xl bg-[#0071e3] text-white font-semibold text-xs shadow-xl shadow-[#0071e3]/20 flex items-center gap-2 transition-all">
      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span id="toastText">Ação realizada com sucesso!</span>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: POSTS & BLOG                        -->
    <!-- ========================================== -->
    <div id="panel-posts" class="admin-tab-panel">
      <!-- Apple Clean Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#86868b]">Total de Posts</span>
            <span class="size-8 rounded-xl bg-[#0071e3]/10 text-[#0071e3] flex items-center justify-center font-bold">
              📝
            </span>
          </div>
          <p id="kpiTotal" class="text-3xl font-extrabold text-[#1d1d1f] dark:text-white mt-2">-</p>
        </div>

        <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#86868b]">Publicados</span>
            <span class="size-8 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
              ✓
            </span>
          </div>
          <p id="kpiPublished" class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-2">-</p>
        </div>

        <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#86868b]">Rascunhos</span>
            <span class="size-8 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold">
              ⏳
            </span>
          </div>
          <p id="kpiDrafts" class="text-3xl font-extrabold text-amber-500 mt-2">-</p>
        </div>

        <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#86868b]">Projetos</span>
            <span class="size-8 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold">
              ⭐
            </span>
          </div>
          <p id="kpiProjects" class="text-3xl font-extrabold text-purple-500 mt-2">-</p>
        </div>
      </div>

      <!-- Controls: Search, Filter & New Post -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
        <div class="relative flex-1 max-w-md">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-[#86868b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="searchInput"
            placeholder="Buscar por título, tag ou slug..."
            class="w-full pl-10 pr-4 py-2.5 rounded-full bg-white dark:bg-[#121215] border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
          />
        </div>

        <div class="flex items-center gap-2">
          <button
            data-filter="all"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#1d1d1f] text-white dark:bg-white dark:text-[#1d1d1f] shadow-xs cursor-pointer transition-all"
          >
            Todos
          </button>
          <button
            data-filter="published"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:bg-neutral-100 dark:hover:bg-white/5 cursor-pointer transition-all"
          >
            Publicados
          </button>
          <button
            data-filter="draft"
            class="filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:bg-neutral-100 dark:hover:bg-white/5 cursor-pointer transition-all"
          >
            Rascunhos
          </button>
          <a
            href="/admin/posts/new"
            class="ml-2 px-4 py-2 text-xs font-bold rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white shadow-sm shadow-[#0071e3]/20 active:scale-[0.98] transition-all flex items-center gap-1.5"
          >
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Novo Post
          </a>
        </div>
      </div>

      <!-- Posts Table Card -->
      <div class="bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 rounded-3xl overflow-hidden shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-neutral-200/70 dark:border-white/10 bg-neutral-50/50 dark:bg-white/5 text-[11px] font-bold text-[#86868b] uppercase tracking-wider">
                <th class="py-4 px-6">Post</th>
                <th class="py-4 px-6">Data</th>
                <th class="py-4 px-6">Tags & Techs</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6 text-right">Ações</th>
              </tr>
            </thead>
            <tbody id="postsTableBody" class="divide-y divide-neutral-200/70 dark:divide-white/5 text-xs font-medium">
              <tr>
                <td colspan="5" class="py-12 text-center text-[#86868b]">
                  <svg class="animate-spin size-6 mx-auto mb-2 text-[#0071e3]" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Carregando publicações do Supabase...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 2: PERFIL & LINKS                      -->
    <!-- ========================================== -->
    <div id="panel-profile" class="admin-tab-panel hidden">
      <form id="profileForm" class="space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-neutral-200/70 dark:border-white/10">
          <div>
            <h2 class="text-xl font-bold text-[#1d1d1f] dark:text-white">Identidade & Links Pessoais</h2>
            <p class="text-xs text-[#86868b]">Configure foto, nome, títulos, resumo e links exibidos na Home e no Rodapé.</p>
          </div>
          <button
            type="submit"
            id="saveProfileBtn"
            class="px-5 py-2.5 rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white font-bold text-xs shadow-sm shadow-[#0071e3]/20 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-2"
          >
            <span>Salvar Perfil</span>
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Coluna 1: Avatar e Imagens -->
          <div class="space-y-6">
            <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] flex flex-col items-center text-center">
              <label class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider mb-4">
                Foto de Perfil (Avatar)
              </label>
              <div class="relative size-36 rounded-full p-[3px] bg-linear-to-tr from-neutral-300 dark:from-white/20 to-neutral-400 dark:to-white/40 mb-4 shadow-sm">
                <img
                  id="profileImagePreview"
                  src="/profile.png"
                  alt="Avatar Preview"
                  class="size-full rounded-full object-cover bg-neutral-200 dark:bg-zinc-800"
                />
              </div>

              <div class="w-full space-y-3">
                <label class="block w-full py-2.5 px-3 rounded-2xl border border-dashed border-neutral-300 dark:border-white/20 hover:border-[#0071e3] text-center cursor-pointer transition-colors bg-neutral-50/50 dark:bg-zinc-900/40">
                  <span class="text-xs font-semibold text-[#1d1d1f] dark:text-neutral-300">📁 Escolher Nova Foto</span>
                  <input type="file" id="profileImageFileInput" accept="image/*" class="hidden" />
                </label>
                <p id="profileUploadStatus" class="text-[11px] text-[#0071e3] hidden font-medium">Fazendo upload...</p>

                <div class="text-left">
                  <label class="block text-[11px] font-semibold text-[#86868b] mb-1">URL Direta da Foto</label>
                  <input
                    type="text"
                    id="profileImageUrlInput"
                    name="profile_image"
                    class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
                  />
                </div>
              </div>
            </div>

            <!-- Imagem de Projetos (Home) -->
            <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
              <label class="block text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider mb-3">
                Capa de Projetos (Home)
              </label>
              <img
                id="portfolioImagePreview"
                src="/portfolio.png"
                alt="Portfolio Preview"
                class="w-full h-32 rounded-2xl object-cover bg-neutral-100 dark:bg-zinc-800 mb-3"
              />
              <label class="block w-full py-2 px-3 rounded-2xl border border-dashed border-neutral-300 dark:border-white/20 hover:border-[#0071e3] text-center cursor-pointer transition-colors bg-neutral-50/50 dark:bg-zinc-900/40 text-xs font-semibold text-[#1d1d1f] dark:text-neutral-300">
                <span>📁 Upload de Capa</span>
                <input type="file" id="portfolioImageFileInput" accept="image/*" class="hidden" />
              </label>
              <input
                type="text"
                id="portfolioImageUrlInput"
                name="portfolio_image"
                class="w-full mt-2 px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
              />
            </div>
          </div>

          <!-- Coluna 2 e 3: Informações e Links -->
          <div class="lg:col-span-2 space-y-6">
            <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
              <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider flex items-center gap-2">
                <span>👤</span> Dados Principais
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">Nome Completo</label>
                  <input
                    type="text"
                    id="profileNameInput"
                    name="profile_name"
                    required
                    class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3]"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">Título / Cargo Principal</label>
                  <input
                    type="text"
                    id="profileTitleInput"
                    name="profile_title"
                    required
                    class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3]"
                  />
                </div>
              </div>

              <div>
                <label class="flex items-center gap-2 cursor-pointer mt-1">
                  <input type="checkbox" id="profileAvailableInput" name="available_for_work" class="rounded text-[#0071e3] focus:ring-[#0071e3] size-4" />
                  <span class="text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea]">Badge ativo na Home: "Disponível para trabalho"</span>
                </label>
              </div>

              <div>
                <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">
                  Resumo da Página Inicial (Hero na Home)
                </label>
                <textarea
                  id="profileBioSummaryInput"
                  name="bio_summary"
                  rows="3"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3]"
                ></textarea>
                <p class="text-[11px] text-[#86868b] mt-1">Texto descritivo exibido logo abaixo do nome e cargo na tela inicial.</p>
              </div>
            </div>

            <!-- Links Pessoais e Redes -->
            <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
              <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider flex items-center gap-2">
                <span>🔗</span> Links Pessoais & Redes Sociais
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">GitHub URL</label>
                  <input
                    type="url"
                    id="profileGithubInput"
                    name="github_url"
                    class="w-full px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">LinkedIn URL</label>
                  <input
                    type="url"
                    id="profileLinkedinInput"
                    name="linkedin_url"
                    class="w-full px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">Instagram URL</label>
                  <input
                    type="url"
                    id="profileInstagramInput"
                    name="instagram_url"
                    class="w-full px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
                  />
                </div>
                <div>
