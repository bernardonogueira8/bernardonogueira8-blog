              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
            />
          </div>

          <div>
            <label class="flex items-center gap-2 cursor-pointer mt-1">
              <input type="checkbox" id="techFeaturedInput" checked class="rounded text-[#0071e3] focus:ring-[#0071e3] size-4" />
              <span class="text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea]">Exibir em destaque na Home</span>
            </label>
          </div>

          <div class="flex items-center justify-end gap-2.5 pt-2">
            <button
              type="button"
              id="cancelTechModalBtn"
              class="px-4 py-2 rounded-full border border-neutral-300 dark:border-white/15 text-xs font-semibold text-[#1d1d1f] dark:text-white hover:bg-neutral-100 dark:hover:bg-white/5"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="px-5 py-2 rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-bold shadow-sm shadow-[#0071e3]/20 active:scale-[0.98]"
            >
              Salvar Tecnologia
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Apple Dynamic Island Floating Toast Notification -->
    <div
      id="toastMessage"
      class="hidden fixed bottom-6 right-6 z-50 px-5 py-3 rounded-full bg-neutral-900/95 dark:bg-white/95 text-white dark:text-neutral-900 backdrop-blur-2xl border border-white/10 dark:border-black/10 shadow-[0_10px_30px_rgba(0,0,0,0.25)] flex items-center gap-2.5 transition-all text-xs font-semibold"
    >
      <span id="toastIcon">✓</span>
      <span id="toastText">Operação realizada com sucesso!</span>
    </div>
  </div>
</Layout>

<script>
  import { supabase, type Post, type Profile, type Experience, type TechStackItem } from "../../lib/supabase";
  import { marked } from "marked";

  // State
  let allPosts: Post[] = [];
  let allExperiences: Experience[] = [];
  let allTechStack: TechStackItem[] = [];
  let currentProfile: Profile | null = null;
  let currentHobbies: string[] = [];
  let currentFilter = "all";
  let searchQuery = "";

  // Elements: Header & Auth
  const userEmailBadge = document.getElementById("userEmailBadge") as HTMLElement;
  const logoutBtn = document.getElementById("logoutBtn") as HTMLButtonElement;
  const toastMessage = document.getElementById("toastMessage") as HTMLElement;
  const toastText = document.getElementById("toastText") as HTMLElement;

  // Elements: Tab Navigation
  const navTabs = document.querySelectorAll(".admin-nav-tab");
  const tabPanels = document.querySelectorAll(".admin-tab-panel");
  const tabCountPosts = document.getElementById("tabCountPosts") as HTMLElement;
  const tabCountExperiences = document.getElementById("tabCountExperiences") as HTMLElement;
  const tabCountTech = document.getElementById("tabCountTech") as HTMLElement;

  // Elements: Posts Tab
  const postsTableBody = document.getElementById("postsTableBody") as HTMLTableSectionElement;
  const searchInput = document.getElementById("searchInput") as HTMLInputElement;
  const filterBtns = document.querySelectorAll(".filter-btn");
  const kpiTotal = document.getElementById("kpiTotal") as HTMLElement;
  const kpiPublished = document.getElementById("kpiPublished") as HTMLElement;
  const kpiDrafts = document.getElementById("kpiDrafts") as HTMLElement;
  const kpiProjects = document.getElementById("kpiProjects") as HTMLElement;

  // Elements: Profile Tab
  const profileForm = document.getElementById("profileForm") as HTMLFormElement;
  const profileImagePreview = document.getElementById("profileImagePreview") as HTMLImageElement;
  const profileImageUrlInput = document.getElementById("profileImageUrlInput") as HTMLInputElement;
  const profileImageFileInput = document.getElementById("profileImageFileInput") as HTMLInputElement;
  const profileUploadStatus = document.getElementById("profileUploadStatus") as HTMLElement;
  const portfolioImagePreview = document.getElementById("portfolioImagePreview") as HTMLImageElement;
  const portfolioImageUrlInput = document.getElementById("portfolioImageUrlInput") as HTMLInputElement;
  const portfolioImageFileInput = document.getElementById("portfolioImageFileInput") as HTMLInputElement;
  const profileNameInput = document.getElementById("profileNameInput") as HTMLInputElement;
  const profileTitleInput = document.getElementById("profileTitleInput") as HTMLInputElement;
  const profileAvailableInput = document.getElementById("profileAvailableInput") as HTMLInputElement;
  const profileBioSummaryInput = document.getElementById("profileBioSummaryInput") as HTMLTextAreaElement;
  const profileGithubInput = document.getElementById("profileGithubInput") as HTMLInputElement;
  const profileLinkedinInput = document.getElementById("profileLinkedinInput") as HTMLInputElement;
  const profileInstagramInput = document.getElementById("profileInstagramInput") as HTMLInputElement;
  const profileYoutubeInput = document.getElementById("profileYoutubeInput") as HTMLInputElement;
  const profileMediumInput = document.getElementById("profileMediumInput") as HTMLInputElement;
  const profileEmailInput = document.getElementById("profileEmailInput") as HTMLInputElement;
  const profileAliasInput = document.getElementById("profileAliasInput") as HTMLInputElement;
  const profileContactTitleInput = document.getElementById("profileContactTitleInput") as HTMLInputElement;
  const profileContactSubtitleInput = document.getElementById("profileContactSubtitleInput") as HTMLInputElement;
  const profileContactBtnTextInput = document.getElementById("profileContactBtnTextInput") as HTMLInputElement;

  // Elements: Experiences Tab & Modal
  const experiencesListContainer = document.getElementById("experiencesListContainer") as HTMLElement;
  const expModal = document.getElementById("expModal") as HTMLElement;
  const expForm = document.getElementById("expForm") as HTMLFormElement;
  const expModalTitle = document.getElementById("expModalTitle") as HTMLElement;
  const expIdInput = document.getElementById("expIdInput") as HTMLInputElement;
  const expTitleInput = document.getElementById("expTitleInput") as HTMLInputElement;
  const expCompanyInput = document.getElementById("expCompanyInput") as HTMLInputElement;
  const expPeriodInput = document.getElementById("expPeriodInput") as HTMLInputElement;
  const expOrderInput = document.getElementById("expOrderInput") as HTMLInputElement;
  const expDescriptionInput = document.getElementById("expDescriptionInput") as HTMLTextAreaElement;
  const openNewExpModalBtn = document.getElementById("openNewExpModalBtn") as HTMLButtonElement;
  const closeExpModalBtn = document.getElementById("closeExpModalBtn") as HTMLButtonElement;
  const cancelExpModalBtn = document.getElementById("cancelExpModalBtn") as HTMLButtonElement;

  // Elements: Tech Stack Tab & Modal
  const techStackGrid = document.getElementById("techStackGrid") as HTMLElement;
  const techModal = document.getElementById("techModal") as HTMLElement;
  const techForm = document.getElementById("techForm") as HTMLFormElement;
  const techModalTitle = document.getElementById("techModalTitle") as HTMLElement;
  const techIdInput = document.getElementById("techIdInput") as HTMLInputElement;
  const techNameInput = document.getElementById("techNameInput") as HTMLInputElement;
  const techKeyInput = document.getElementById("techKeyInput") as HTMLInputElement;
  const techCategoryInput = document.getElementById("techCategoryInput") as HTMLInputElement;
  const techOrderInput = document.getElementById("techOrderInput") as HTMLInputElement;
  const techFeaturedInput = document.getElementById("techFeaturedInput") as HTMLInputElement;
  const openNewTechModalBtn = document.getElementById("openNewTechModalBtn") as HTMLButtonElement;
  const closeTechModalBtn = document.getElementById("closeTechModalBtn") as HTMLButtonElement;
  const cancelTechModalBtn = document.getElementById("cancelTechModalBtn") as HTMLButtonElement;

  // Elements: About Tab
  const aboutForm = document.getElementById("aboutForm") as HTMLFormElement;
  const aboutTitleInput = document.getElementById("aboutTitleInput") as HTMLInputElement;
  const aboutDescriptionInput = document.getElementById("aboutDescriptionInput") as HTMLTextAreaElement;
  const aboutHeadlineInput = document.getElementById("aboutHeadlineInput") as HTMLTextAreaElement;
  const aboutContentInput = document.getElementById("aboutContentInput") as HTMLTextAreaElement;
  const hobbiesContainer = document.getElementById("hobbiesContainer") as HTMLElement;
  const newHobbyInput = document.getElementById("newHobbyInput") as HTMLInputElement;
  const addHobbyBtn = document.getElementById("addHobbyBtn") as HTMLButtonElement;
  const aboutTabEditorBtn = document.getElementById("aboutTabEditorBtn") as HTMLButtonElement;
  const aboutTabPreviewBtn = document.getElementById("aboutTabPreviewBtn") as HTMLButtonElement;
  const aboutEditorContainer = document.getElementById("aboutEditorContainer") as HTMLElement;
  const aboutPreviewContainer = document.getElementById("aboutPreviewContainer") as HTMLElement;
  const aboutPreviewOutput = document.getElementById("aboutPreviewOutput") as HTMLElement;

  // Helper: Toast (Apple Dynamic Island style)
  function showToast(msg: string, isError = false) {
    if (!toastMessage || !toastText) return;
    toastText.textContent = msg;
    const toastIcon = document.getElementById("toastIcon");
    if (toastIcon) toastIcon.textContent = isError ? "⚠️" : "✓";
    toastMessage.className = `fixed bottom-6 right-6 z-50 px-5 py-3 rounded-full backdrop-blur-2xl border shadow-xl flex items-center gap-2.5 transition-all text-xs font-semibold ${
      isError
        ? "bg-rose-500/90 text-white border-rose-400/30 shadow-rose-500/25"
        : "bg-neutral-900/95 dark:bg-white/95 text-white dark:text-neutral-900 border-white/10 dark:border-black/10 shadow-[0_10px_30px_rgba(0,0,0,0.25)]"
    }`;
    toastMessage.classList.remove("hidden");
    setTimeout(() => toastMessage.classList.add("hidden"), 3500);
  }

  // Auth Initialization
  async function initAuth() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = "/admin/login";
      return;
    }
    const email = data.session.user.email || "Administrador";
    userEmailBadge.textContent = `Autenticado: ${email}`;

    // Load all data
    loadPosts();
    loadProfile();
    loadExperiences();
    loadTechStack();
  }

  logoutBtn.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.href = "/admin/login";
  });

  // Tab Switching (Apple style pill transition)
  function switchTab(tabName: string) {
    navTabs.forEach((tab) => {
      const active = tab.getAttribute("data-tab") === tabName;
      if (active) {
        tab.className = "admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs";
      } else {
        tab.className = "admin-nav-tab flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer whitespace-nowrap text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white";
      }
    });

    tabPanels.forEach((panel) => {
      panel.classList.add("hidden");
    });
    const activePanel = document.getElementById(`panel-${tabName}`);
    if (activePanel) activePanel.classList.remove("hidden");

    window.location.hash = tabName;
  }

  navTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const t = tab.getAttribute("data-tab");
      if (t) switchTab(t);
    });
  });

  // Check URL Hash on load
  const initialHash = window.location.hash.replace("#", "");
  if (["posts", "profile", "experiences", "tech-stack", "about"].includes(initialHash)) {
    switchTab(initialHash);
  }

  // ==========================================
  // TAB 1: POSTS LOGIC
  // ==========================================
  async function loadPosts() {
    try {
      const { data, error } = await supabase
        .from("posts")
        .select("*")
        .order("pub_date", { ascending: false });

      if (error) throw error;
      allPosts = data || [];
      tabCountPosts.textContent = String(allPosts.length);
      updateKPIs();
      renderPostsTable();
    } catch (err: any) {
      console.error(err);
      postsTableBody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-500">Erro: ${err.message}</td></tr>`;
    }
  }

  function updateKPIs() {
    kpiTotal.textContent = String(allPosts.length);
    kpiPublished.textContent = String(allPosts.filter((p) => p.status === "published").length);
    kpiDrafts.textContent = String(allPosts.filter((p) => p.status === "draft").length);
    kpiProjects.textContent = String(allPosts.filter((p) => p.project).length);
  }

  function renderPostsTable() {
    const filtered = allPosts.filter((post) => {
      const matchesSearch =
        searchQuery === "" ||
        post.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
        post.slug.toLowerCase().includes(searchQuery.toLowerCase()) ||
        (post.tags && post.tags.some((t) => t.toLowerCase().includes(searchQuery.toLowerCase())));
      const matchesStatus = currentFilter === "all" || post.status === currentFilter;
      return matchesSearch && matchesStatus;
    });

    if (filtered.length === 0) {
      postsTableBody.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-[#86868b]">Nenhum post encontrado.</td></tr>`;
      return;
    }

    postsTableBody.innerHTML = filtered.map((post) => {
      const isPublished = post.status === "published";
      const imageThumbnail = post.image_url
        ? `<img src="${post.image_url}" alt="" class="size-10 rounded-xl object-cover bg-neutral-200 dark:bg-zinc-800 shrink-0" />`
        : `<div class="size-10 rounded-xl bg-neutral-100 dark:bg-zinc-800 flex items-center justify-center text-[#86868b] shrink-0 font-bold text-xs">P</div>`;

      return `
        <tr class="hover:bg-neutral-50/50 dark:hover:bg-white/5 transition-colors">
          <td class="py-4 px-6">
            <div class="flex items-center gap-3">
              ${imageThumbnail}
              <div class="min-w-0">
                <a href="/admin/posts/edit?id=${post.id}" class="font-bold text-[#1d1d1f] dark:text-white hover:text-[#0071e3] transition-colors block truncate max-w-sm">
                  ${post.title}
                </a>
                <span class="text-[11px] text-[#86868b] font-mono block truncate">/blog/posts/${post.slug}</span>
                ${post.project ? '<span class="inline-block text-[10px] font-bold text-amber-500 uppercase tracking-wider mt-0.5">⭐ Projeto</span>' : ''}
              </div>
            </div>
          </td>
          <td class="py-4 px-6 whitespace-nowrap text-xs text-[#86868b]">${post.pub_date || "-"}</td>
          <td class="py-4 px-6">
            <div class="flex flex-wrap max-w-xs gap-1">
              ${(post.tags || []).slice(0, 2).map((t) => `<span class="px-2.5 py-0.5 text-[11px] rounded-full bg-neutral-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 font-medium">${t}</span>`).join("")}
            </div>
          </td>
          <td class="py-4 px-6 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold ${
              isPublished
                ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
                : "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20"
            }">
              <span class="size-1.5 rounded-full ${isPublished ? "bg-emerald-500" : "bg-amber-500"}"></span>
              ${isPublished ? "Publicado" : "Rascunho"}
            </span>
          </td>
          <td class="py-4 px-6 whitespace-nowrap text-right text-xs font-medium space-x-2">
            <a href="/blog/posts/${post.slug}" target="_blank" class="inline-flex items-center justify-center size-8 rounded-full text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-zinc-800 transition-all" title="Ver post">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            </a>
            <a href="/admin/posts/edit?id=${post.id}" class="inline-flex items-center justify-center size-8 rounded-full text-[#0071e3] hover:bg-[#0071e3]/10 transition-all" title="Editar">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            </a>
            <button data-id="${post.id}" data-status="${post.status}" class="toggle-status-btn inline-flex items-center justify-center size-8 rounded-full text-amber-500 hover:bg-amber-500/10 cursor-pointer transition-all" title="${isPublished ? 'Mudar para rascunho' : 'Publicar'}">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
            </button>
            <button data-id="${post.id}" data-title="${post.title.replace(/"/g, '&quot;')}" class="delete-post-btn inline-flex items-center justify-center size-8 rounded-full text-rose-500 hover:bg-rose-500/10 cursor-pointer transition-all" title="Excluir">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          </td>
        </tr>
      `;
    }).join("");

    attachPostEventListeners();
  }

  function attachPostEventListeners() {
    document.querySelectorAll(".toggle-status-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id");
        const status = target.getAttribute("data-status");
        if (!id) return;
        const newStatus = status === "published" ? "draft" : "published";
        const { error } = await supabase.from("posts").update({ status: newStatus, updated_at: new Date().toISOString() }).eq("id", id);
        if (error) {
          showToast(`Erro: ${error.message}`, true);
        } else {
          showToast(`Post alterado para ${newStatus === "published" ? "Publicado" : "Rascunho"}!`);
          loadPosts();
        }
      });
    });

    document.querySelectorAll(".delete-post-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id");
        const title = target.getAttribute("data-title");
        if (!id) return;
        if (confirm(`Excluir o post:\n"${title}"?`)) {
          const { error } = await supabase.from("posts").delete().eq("id", id);
          if (error) {
            showToast(`Erro: ${error.message}`, true);
          } else {
            showToast("Post excluído com sucesso!");
            loadPosts();
          }
        }
      });
    });
  }

  searchInput.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    renderPostsTable();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      filterBtns.forEach((b) => {
        b.className = "filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:bg-neutral-100 dark:hover:bg-white/5 cursor-pointer transition-all";
      });
      target.className = "filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#1d1d1f] text-white dark:bg-white dark:text-[#1d1d1f] shadow-xs cursor-pointer transition-all";
      currentFilter = target.getAttribute("data-filter") || "all";
      renderPostsTable();
    });
  });

  // ==========================================
  // TAB 2: PROFILE LOGIC
  // ==========================================
  async function loadProfile() {
    try {
      const { data, error } = await supabase.from("profile").select("*").eq("id", "main").maybeSingle();
      if (error) throw error;
      if (!data) return;

      currentProfile = data;
      // Populate Profile Tab
      profileNameInput.value = data.profile_name || "";
      profileTitleInput.value = data.profile_title || "";
      profileAvailableInput.checked = !!data.available_for_work;
      profileBioSummaryInput.value = data.bio_summary || "";
      profileImageUrlInput.value = data.profile_image || "/profile.png";
      profileImagePreview.src = data.profile_image || "/profile.png";
      portfolioImageUrlInput.value = data.portfolio_image || "/portfolio.png";
      portfolioImagePreview.src = data.portfolio_image || "/portfolio.png";

      profileGithubInput.value = data.github_url || "";
      profileLinkedinInput.value = data.linkedin_url || "";
      profileInstagramInput.value = data.instagram_url || "";
      profileYoutubeInput.value = data.youtube_url || "";
      profileMediumInput.value = data.medium_url || "";
      profileEmailInput.value = data.email || "";
      profileAliasInput.value = data.alias || "";

      profileContactTitleInput.value = data.contact_title || "";
      profileContactSubtitleInput.value = data.contact_subtitle || "";
      profileContactBtnTextInput.value = data.contact_button_text || "";

      // Populate About Tab
      aboutTitleInput.value = data.about_title || "";
      aboutDescriptionInput.value = data.about_description || "";
      aboutHeadlineInput.value = data.headline || "";
      aboutContentInput.value = data.about_content || "";
      currentHobbies = Array.isArray(data.hobbies) ? data.hobbies : [];
      renderHobbies();
    } catch (err: any) {
      console.error("Erro ao carregar perfil:", err);
    }
  }

  // File Upload Helper to Supabase Storage
  async function uploadImageFile(file: File, folder = "profile"): Promise<string> {
    const ext = file.name.split(".").pop();
    const fileName = `${folder}-${Date.now()}-${Math.random().toString(36).substring(2, 7)}.${ext}`;
    const filePath = `uploads/${fileName}`;

    const { error: uploadError } = await supabase.storage.from("blog-images").upload(filePath, file, {
      cacheControl: "3600",
      upsert: true,
    });
    if (uploadError) throw uploadError;

    const { data: publicUrlData } = supabase.storage.from("blog-images").getPublicUrl(filePath);
    return publicUrlData.publicUrl;
  }

  profileImageFileInput.addEventListener("change", async () => {
    const file = profileImageFileInput.files?.[0];
    if (!file) return;
    profileUploadStatus.classList.remove("hidden");
    profileUploadStatus.textContent = "Fazendo upload da foto...";
    try {
      const url = await uploadImageFile(file, "avatar");
      profileImageUrlInput.value = url;
      profileImagePreview.src = url;
      profileUploadStatus.textContent = "Upload concluído!";
      setTimeout(() => profileUploadStatus.classList.add("hidden"), 3000);
      showToast("Foto enviada com sucesso!");
    } catch (err: any) {
      profileUploadStatus.textContent = `Erro: ${err.message}`;
      showToast(`Erro no upload: ${err.message}`, true);
    }
  });

  profileImageUrlInput.addEventListener("input", () => {
    profileImagePreview.src = profileImageUrlInput.value || "/profile.png";
  });

  portfolioImageFileInput.addEventListener("change", async () => {
    const file = portfolioImageFileInput.files?.[0];
    if (!file) return;
    try {
      const url = await uploadImageFile(file, "portfolio");
      portfolioImageUrlInput.value = url;
      portfolioImagePreview.src = url;
      showToast("Capa de portfólio enviada com sucesso!");
    } catch (err: any) {
      showToast(`Erro no upload: ${err.message}`, true);
    }
  });

  portfolioImageUrlInput.addEventListener("input", () => {
    portfolioImagePreview.src = portfolioImageUrlInput.value || "/portfolio.png";
  });

  profileForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const updates = {
      profile_name: profileNameInput.value.trim(),
      profile_title: profileTitleInput.value.trim(),
      available_for_work: profileAvailableInput.checked,
      bio_summary: profileBioSummaryInput.value.trim(),
      profile_image: profileImageUrlInput.value.trim() || "/profile.png",
      portfolio_image: portfolioImageUrlInput.value.trim() || "/portfolio.png",
      github_url: profileGithubInput.value.trim(),
      linkedin_url: profileLinkedinInput.value.trim(),
      instagram_url: profileInstagramInput.value.trim(),
      youtube_url: profileYoutubeInput.value.trim(),
      medium_url: profileMediumInput.value.trim(),
      email: profileEmailInput.value.trim(),
      alias: profileAliasInput.value.trim(),
      contact_title: profileContactTitleInput.value.trim(),
      contact_subtitle: profileContactSubtitleInput.value.trim(),
      contact_button_text: profileContactBtnTextInput.value.trim(),
      updated_at: new Date().toISOString(),
    };

    const { error } = await supabase.from("profile").upsert({ id: "main", ...updates });
    if (error) {
      showToast(`Erro ao salvar perfil: ${error.message}`, true);
    } else {
      showToast("Perfil e links atualizados com sucesso!");
    }
  });

  // ==========================================
  // TAB 3: EXPERIÊNCIAS LOGIC
  // ==========================================
  async function loadExperiences() {
    try {
      const { data, error } = await supabase.from("experiences").select("*").order("order_index", { ascending: false });
      if (error) throw error;
      allExperiences = data || [];
      tabCountExperiences.textContent = String(allExperiences.length);
      renderExperiences();
    } catch (err: any) {
      experiencesListContainer.innerHTML = `<div class="p-6 text-center text-rose-500">Erro: ${err.message}</div>`;
    }
  }

  function renderExperiences() {
    if (allExperiences.length === 0) {
      experiencesListContainer.innerHTML = `<div class="p-8 text-center text-[#86868b] bg-white/50 dark:bg-zinc-900/50 rounded-3xl border border-neutral-200/80 dark:border-white/10">Nenhuma experiência cadastrada. Clique em "+ Nova Experiência".</div>`;
      return;
    }

    experiencesListContainer.innerHTML = allExperiences.map((exp) => `
      <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-[#0071e3]/40 transition-colors">
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#0071e3]/10 text-[#0071e3] text-[10px] font-mono font-bold">#${exp.order_index}</span>
            <h3 class="font-extrabold text-[#1d1d1f] dark:text-white text-base">${exp.title}</h3>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-xs text-[#86868b] font-medium">
            <span class="text-[#1d1d1f] dark:text-white font-semibold">${exp.company}</span>
            <span>•</span>
            <span>${exp.period}</span>
          </div>
          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] line-clamp-2 mt-1">${exp.description}</p>
        </div>

        <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
          <button data-id="${exp.id}" class="edit-exp-btn px-3.5 py-1.5 rounded-full border border-neutral-300/80 dark:border-white/15 text-xs font-semibold text-[#1d1d1f] dark:text-white hover:bg-neutral-100 dark:hover:bg-white/5 transition-colors cursor-pointer flex items-center gap-1.5">
            <svg class="size-3.5 text-[#0071e3]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            Editar
          </button>
          <button data-id="${exp.id}" data-title="${exp.title.replace(/"/g, '&quot;')}" class="delete-exp-btn px-3.5 py-1.5 rounded-full border border-rose-500/20 text-rose-500 hover:bg-rose-500/10 text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Excluir
          </button>
        </div>
      </div>
    `).join("");

    attachExpEventListeners();
  }

  function attachExpEventListeners() {
    document.querySelectorAll(".edit-exp-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        const exp = allExperiences.find((e) => e.id === id);
        if (!exp) return;
        expIdInput.value = exp.id;
        expTitleInput.value = exp.title;
        expCompanyInput.value = exp.company;
        expPeriodInput.value = exp.period;
        expOrderInput.value = String(exp.order_index);
        expDescriptionInput.value = exp.description;
        expModalTitle.textContent = "Editar Experiência";
        expModal.classList.remove("hidden");
      });
    });

    document.querySelectorAll(".delete-exp-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        const title = btn.getAttribute("data-title");
        if (!id) return;
        if (confirm(`Excluir a experiência:\n"${title}"?`)) {
          const { error } = await supabase.from("experiences").delete().eq("id", id);
          if (error) {
            showToast(`Erro: ${error.message}`, true);
          } else {
            showToast("Experiência excluída!");
            loadExperiences();
          }
        }
      });
    });
  }

  openNewExpModalBtn.addEventListener("click", () => {
    expForm.reset();
    expIdInput.value = "";
    expOrderInput.value = String(allExperiences.length + 1);
    expModalTitle.textContent = "Nova Experiência";
    expModal.classList.remove("hidden");
  });

  closeExpModalBtn.addEventListener("click", () => expModal.classList.add("hidden"));
  cancelExpModalBtn.addEventListener("click", () => expModal.classList.add("hidden"));

  expForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = expIdInput.value;
    const expData = {
      title: expTitleInput.value.trim(),
      company: expCompanyInput.value.trim(),
      period: expPeriodInput.value.trim(),
      order_index: parseInt(expOrderInput.value, 10) || 1,
      description: expDescriptionInput.value.trim(),
      updated_at: new Date().toISOString(),
    };

    if (id) {
      const { error } = await supabase.from("experiences").update(expData).eq("id", id);
      if (error) {
        showToast(`Erro: ${error.message}`, true);
      } else {
        showToast("Experiência atualizada com sucesso!");
        expModal.classList.add("hidden");
        loadExperiences();
      }
    } else {
      const { error } = await supabase.from("experiences").insert([expData]);
      if (error) {
        showToast(`Erro: ${error.message}`, true);
      } else {
        showToast("Experiência criada com sucesso!");
        expModal.classList.add("hidden");
        loadExperiences();
      }
    }
  });

  // ==========================================
  // TAB 4: TECH STACK LOGIC
  // ==========================================
  async function loadTechStack() {
    try {
      const { data, error } = await supabase.from("tech_stack").select("*").order("order_index", { ascending: true });
      if (error) throw error;
      allTechStack = data || [];
      tabCountTech.textContent = String(allTechStack.length);
      renderTechStack();
    } catch (err: any) {
      techStackGrid.innerHTML = `<div class="col-span-full p-6 text-center text-rose-500">Erro: ${err.message}</div>`;
    }
  }

  function renderTechStack() {
    if (allTechStack.length === 0) {
      techStackGrid.innerHTML = `<div class="col-span-full p-8 text-center text-[#86868b] bg-white/50 dark:bg-zinc-900/50 rounded-3xl border border-neutral-200/80 dark:border-white/10">Nenhuma tecnologia cadastrada. Clique em "+ Nova Tecnologia".</div>`;
      return;
    }

    techStackGrid.innerHTML = allTechStack.map((tech) => `
      <div class="p-5 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] flex flex-col justify-between hover:border-[#0071e3]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="px-2.5 py-0.5 rounded-full bg-neutral-100 dark:bg-zinc-800 text-[#86868b] text-[10px] font-mono font-bold">#${tech.order_index}</span>
            ${tech.is_featured ? '<span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#0071e3]/10 text-[#0071e3] font-bold">Home</span>' : ''}
          </div>
          <div class="flex items-center gap-3">
            <div class="size-9 rounded-2xl bg-neutral-100 dark:bg-zinc-800 flex items-center justify-center font-bold text-xs text-[#0071e3]">
              ${tech.key.slice(0, 3).toUpperCase()}
            </div>
            <div>
              <h4 class="font-extrabold text-sm text-[#1d1d1f] dark:text-white">${tech.name}</h4>
              <p class="text-[11px] text-[#86868b] font-mono">key: ${tech.key}</p>
            </div>
          </div>
          <span class="inline-block mt-3 px-2.5 py-0.5 rounded-full text-[11px] bg-neutral-100 dark:bg-zinc-800 text-[#6e6e73] dark:text-[#a1a1a6] font-medium">
            ${tech.category || "Geral"}
          </span>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 mt-3 border-t border-neutral-100 dark:border-white/5">
          <button data-id="${tech.id}" class="edit-tech-btn text-xs font-semibold text-[#0071e3] hover:underline cursor-pointer">Editar</button>
          <span class="text-neutral-300 dark:text-zinc-700">•</span>
          <button data-id="${tech.id}" data-name="${tech.name.replace(/"/g, '&quot;')}" class="delete-tech-btn text-xs font-semibold text-rose-500 hover:underline cursor-pointer">Excluir</button>
        </div>
      </div>
    `).join("");

    attachTechEventListeners();
  }

  function attachTechEventListeners() {
    document.querySelectorAll(".edit-tech-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");
        const tech = allTechStack.find((t) => t.id === id);
        if (!tech) return;
        techIdInput.value = tech.id;
        techNameInput.value = tech.name;
        techKeyInput.value = tech.key;
        techCategoryInput.value = tech.category;
        techOrderInput.value = String(tech.order_index);
        techFeaturedInput.checked = tech.is_featured;
        techModalTitle.textContent = "Editar Tecnologia";
        techModal.classList.remove("hidden");
      });
    });

    document.querySelectorAll(".delete-tech-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        const name = btn.getAttribute("data-name");
        if (!id) return;
        if (confirm(`Excluir a tecnologia "${name}"?`)) {
          const { error } = await supabase.from("tech_stack").delete().eq("id", id);
          if (error) {
            showToast(`Erro: ${error.message}`, true);
          } else {
            showToast("Tecnologia excluída!");
            loadTechStack();
          }
        }
      });
    });
  }

  openNewTechModalBtn.addEventListener("click", () => {
    techForm.reset();
    techIdInput.value = "";
    techOrderInput.value = String(allTechStack.length + 1);
    techFeaturedInput.checked = true;
    techModalTitle.textContent = "Nova Tecnologia";
    techModal.classList.remove("hidden");
  });

  closeTechModalBtn.addEventListener("click", () => techModal.classList.add("hidden"));
  cancelTechModalBtn.addEventListener("click", () => techModal.classList.add("hidden"));

  techForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = techIdInput.value;
    const techData = {
      name: techNameInput.value.trim(),
      key: techKeyInput.value.trim().toLowerCase(),
      category: techCategoryInput.value.trim() || "Geral",
      order_index: parseInt(techOrderInput.value, 10) || 1,
      is_featured: techFeaturedInput.checked,
      updated_at: new Date().toISOString(),
    };

    if (id) {
      const { error } = await supabase.from("tech_stack").update(techData).eq("id", id);
      if (error) {
        showToast(`Erro: ${error.message}`, true);
      } else {
        showToast("Tecnologia atualizada com sucesso!");
        techModal.classList.add("hidden");
        loadTechStack();
      }
    } else {
      const { error } = await supabase.from("tech_stack").insert([techData]);
      if (error) {
        showToast(`Erro: ${error.message}`, true);
      } else {
        showToast("Tecnologia adicionada com sucesso!");
        techModal.classList.add("hidden");
        loadTechStack();
      }
    }
  });

  // ==========================================
  // TAB 5: SOBRE MIM & HOBBIES LOGIC
  // ==========================================
  function renderHobbies() {
    hobbiesContainer.innerHTML = currentHobbies.map((hobby, index) => `
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-neutral-100 dark:bg-zinc-800 text-[#1d1d1f] dark:text-white border border-neutral-200/80 dark:border-white/10">
        ${hobby}
        <button type="button" data-index="${index}" class="remove-hobby-btn text-[#86868b] hover:text-rose-500 font-bold">&times;</button>
      </span>
    `).join("");

    document.querySelectorAll(".remove-hobby-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-index") || "-1", 10);
        if (idx >= 0) {
          currentHobbies.splice(idx, 1);
          renderHobbies();
        }
      });
    });
  }

  function addHobby() {
    const val = newHobbyInput.value.trim();
    if (val && !currentHobbies.includes(val)) {
      currentHobbies.push(val);
      renderHobbies();
      newHobbyInput.value = "";
    }
  }

  addHobbyBtn.addEventListener("click", addHobby);
  newHobbyInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addHobby();
    }
  });

  // Editor vs Preview Tabs in About
  aboutTabEditorBtn.addEventListener("click", () => {
    aboutTabEditorBtn.className = "px-3.5 py-1 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs cursor-pointer transition-all";
    aboutTabPreviewBtn.className = "px-3.5 py-1 rounded-lg text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white cursor-pointer transition-all";
    aboutEditorContainer.classList.remove("hidden");
    aboutPreviewContainer.classList.add("hidden");
  });

  aboutTabPreviewBtn.addEventListener("click", async () => {
    aboutTabPreviewBtn.className = "px-3.5 py-1 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs cursor-pointer transition-all";
    aboutTabEditorBtn.className = "px-3.5 py-1 rounded-lg text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white cursor-pointer transition-all";
    aboutEditorContainer.classList.add("hidden");
    aboutPreviewContainer.classList.remove("hidden");
    aboutPreviewOutput.innerHTML = (await marked.parse(aboutContentInput.value || "*Nenhum conteúdo ainda...*")) as string;
  });

  // Toolbar in About
  document.querySelectorAll(".about-tool-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      const start = aboutContentInput.selectionStart;
      const end = aboutContentInput.selectionEnd;
      const text = aboutContentInput.value;
      const selected = text.substring(start, end);

      let insert = "";
      switch (cmd) {
        case "bold":
          insert = `**${selected || "texto em negrito"}**`;
          break;
        case "italic":
          insert = `*${selected || "texto em itálico"}*`;
          break;
        case "h2":
          insert = `\n## ${selected || "Título H2"}\n`;
          break;
        case "h3":
          insert = `\n### ${selected || "Título H3"}\n`;
          break;
        case "quote":
          insert = `\n> ${selected || "Citação inspiradora"}\n`;
          break;
        case "image": {
          const url = prompt("Cole a URL direta do GIF ou da Imagem (ex: Giphy, Tenor ou upload):");
          if (!url || !url.trim()) return;
          const caption = prompt("Legenda da imagem/GIF (opcional):") || "Demonstração";
          insert = `\n![${caption}](${url.trim()})\n`;
          break;
        }
        case "youtube": {
          const input = prompt("Cole o link ou ID do vídeo do YouTube:");
          if (!input || !input.trim()) return;
          const videoId = extractYouTubeId(input);
          if (!videoId) {
            alert("Não foi possível identificar o ID do vídeo do YouTube.");
            return;
          }
          insert = `\n<div class="video-responsive">\n  <iframe src="https://www.youtube.com/embed/${videoId}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>\n</div>\n`;
          break;
        }
      }

      aboutContentInput.setRangeText(insert, start, end, "end");
      aboutContentInput.focus();
    });
  });

  function extractYouTubeId(url: string): string | null {
    if (!url) return null;
    url = url.trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return url;
    const matchWatch = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
    if (matchWatch) return matchWatch[1];
    const matchShort = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
    if (matchShort) return matchShort[1];
    const matchEmbed = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]{11})/);
    if (matchEmbed) return matchEmbed[1];
    const matchShorts = url.match(/youtube\.com\/shorts\/([a-zA-Z0-9_-]{11})/);
    if (matchShorts) return matchShorts[1];
    return null;
  }

  aboutForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const updates = {
      about_title: aboutTitleInput.value.trim(),
      about_description: aboutDescriptionInput.value.trim(),
      headline: aboutHeadlineInput.value.trim(),
      about_content: aboutContentInput.value,
      hobbies: currentHobbies,
      updated_at: new Date().toISOString(),
    };

    const { error } = await supabase.from("profile").upsert({ id: "main", ...updates });
    if (error) {
      showToast(`Erro ao salvar Sobre Mim: ${error.message}`, true);
    } else {
      showToast("Conteúdo da página Sobre Mim salvo com sucesso!");
    }
  });

  initAuth();
</script>
