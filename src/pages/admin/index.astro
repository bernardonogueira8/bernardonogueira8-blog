---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Painel Administrativo | Bernardo SaaS Studio";
---

<Layout pageTitle={pageTitle}>
  <div id="adminApp" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[85vh]">
    <!-- Top Navigation / Header -->
    <header class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-8 border-b border-neutral-200 dark:border-zinc-800">
      <div>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center size-10 rounded-xl bg-linear-to-tr from-mint-500 to-emerald-600 text-white font-bold text-lg shadow-md shadow-mint-500/20">
            BN
          </span>
          <div>
            <h1 class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight flex items-center gap-2">
              SaaS Blog Studio
              <span class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-mint-500/10 text-mint-500 border border-mint-500/20">
                Supabase + Vercel
              </span>
            </h1>
            <p id="userEmailBadge" class="text-xs text-neutral-500 dark:text-neutral-400">Verificando sessão...</p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/blog/"
          target="_blank"
          class="px-4 py-2 text-xs font-semibold rounded-xl border border-neutral-300 dark:border-zinc-700 hover:bg-neutral-100 dark:hover:bg-zinc-800 text-neutral-700 dark:text-neutral-300 transition-all flex items-center gap-1.5"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver Blog
        </a>
        <a
          href="/admin/posts/new"
          class="px-4 py-2 text-xs font-semibold rounded-xl bg-linear-to-r from-mint-500 to-emerald-600 hover:from-mint-600 hover:to-emerald-700 text-white shadow-md shadow-mint-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-1.5"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Novo Post
        </a>
        <button
          id="logoutBtn"
          class="px-3.5 py-2 text-xs font-semibold rounded-xl border border-rose-500/20 text-rose-500 hover:bg-rose-500/10 transition-all cursor-pointer flex items-center gap-1"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sair
        </button>
      </div>
    </header>

    <!-- KPI / Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-8">
      <div class="p-5 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-neutral-200 dark:border-zinc-800 backdrop-blur-md shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Total de Posts</span>
          <span class="size-8 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </span>
        </div>
        <p id="kpiTotal" class="text-3xl font-bold text-neutral-900 dark:text-white mt-2">-</p>
      </div>

      <div class="p-5 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-neutral-200 dark:border-zinc-800 backdrop-blur-md shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Publicados</span>
          <span class="size-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </span>
        </div>
        <p id="kpiPublished" class="text-3xl font-bold text-emerald-500 mt-2">-</p>
      </div>

      <div class="p-5 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-neutral-200 dark:border-zinc-800 backdrop-blur-md shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Rascunhos</span>
          <span class="size-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          </span>
        </div>
        <p id="kpiDrafts" class="text-3xl font-bold text-amber-500 mt-2">-</p>
      </div>

      <div class="p-5 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-neutral-200 dark:border-zinc-800 backdrop-blur-md shadow-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Projetos em Destaque</span>
          <span class="size-8 rounded-lg bg-purple-500/10 text-purple-500 flex items-center justify-center">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
          </span>
        </div>
        <p id="kpiProjects" class="text-3xl font-bold text-purple-500 mt-2">-</p>
      </div>
    </div>

    <!-- Controls: Search and Filter -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
      <div class="relative flex-1 max-w-md">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar por título, tag ou slug..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white dark:bg-zinc-900 border border-neutral-200 dark:border-zinc-800 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-mint-500 transition-all"
        />
      </div>

      <div class="flex items-center gap-2">
        <button
          data-filter="all"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 cursor-pointer"
        >
          Todos
        </button>
        <button
          data-filter="published"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-zinc-800 cursor-pointer"
        >
          Publicados
        </button>
        <button
          data-filter="draft"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-zinc-800 cursor-pointer"
        >
          Rascunhos
        </button>
      </div>
    </div>

    <!-- Posts Table / List Card -->
    <div class="bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md border border-neutral-200 dark:border-zinc-800 rounded-3xl overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-neutral-200 dark:border-zinc-800 bg-neutral-50/50 dark:bg-zinc-800/30 text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
              <th class="py-4 px-6">Post</th>
              <th class="py-4 px-6">Data</th>
              <th class="py-4 px-6">Tags & Techs</th>
              <th class="py-4 px-6">Status</th>
              <th class="py-4 px-6 text-right">Ações</th>
            </tr>
          </thead>
          <tbody id="postsTableBody" class="divide-y divide-neutral-200 dark:divide-zinc-800 text-sm">
            <tr>
              <td colspan="5" class="py-12 text-center text-neutral-400">
                <svg class="animate-spin size-6 mx-auto mb-2 text-mint-500" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Carregando posts do Supabase...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase, type Post } from "../../lib/supabase";

  let allPosts: Post[] = [];
  let currentFilter = "all";
  let searchQuery = "";

  const userEmailBadge = document.getElementById("userEmailBadge") as HTMLElement;
  const logoutBtn = document.getElementById("logoutBtn") as HTMLButtonElement;
  const postsTableBody = document.getElementById("postsTableBody") as HTMLTableSectionElement;
  const searchInput = document.getElementById("searchInput") as HTMLInputElement;
  const filterBtns = document.querySelectorAll(".filter-btn");

  const kpiTotal = document.getElementById("kpiTotal") as HTMLElement;
  const kpiPublished = document.getElementById("kpiPublished") as HTMLElement;
  const kpiDrafts = document.getElementById("kpiDrafts") as HTMLElement;
  const kpiProjects = document.getElementById("kpiProjects") as HTMLElement;

  // Check Auth Session
  async function initAuth() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = "/admin/login";
      return;
    }
    const email = data.session.user.email || "Administrador";
    userEmailBadge.textContent = `Autenticado: ${email}`;
    loadPosts();
  }

  logoutBtn.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.href = "/admin/login";
  });

  async function loadPosts() {
    try {
      const { data, error } = await supabase
        .from("posts")
        .select("*")
        .order("pub_date", { ascending: false });

      if (error) throw error;
      allPosts = data || [];
      updateKPIs();
      renderTable();
    } catch (err: any) {
      console.error(err);
      postsTableBody.innerHTML = `
        <tr>
          <td colspan="5" class="py-8 text-center text-rose-500 font-medium">
            Erro ao carregar posts: ${err.message}
          </td>
        </tr>
      `;
    }
  }

  function updateKPIs() {
    kpiTotal.textContent = String(allPosts.length);
    kpiPublished.textContent = String(allPosts.filter((p) => p.status === "published").length);
    kpiDrafts.textContent = String(allPosts.filter((p) => p.status === "draft").length);
    kpiProjects.textContent = String(allPosts.filter((p) => p.project).length);
  }

  function renderTable() {
    const filtered = allPosts.filter((post) => {
      const matchesSearch =
        searchQuery === "" ||
        post.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
        post.slug.toLowerCase().includes(searchQuery.toLowerCase()) ||
        (post.tags && post.tags.some((t) => t.toLowerCase().includes(searchQuery.toLowerCase())));

      const matchesStatus =
        currentFilter === "all" || post.status === currentFilter;

      return matchesSearch && matchesStatus;
    });

    if (filtered.length === 0) {
      postsTableBody.innerHTML = `
        <tr>
          <td colspan="5" class="py-12 text-center text-neutral-400">
            Nenhum post encontrado com os filtros atuais.
          </td>
        </tr>
      `;
      return;
    }

    postsTableBody.innerHTML = filtered
      .map((post) => {
        const isPublished = post.status === "published";
        const tagsBadges = (post.tags || [])
          .slice(0, 3)
          .map(
            (t) =>
              `<span class="inline-block px-2 py-0.5 text-xs rounded-md bg-neutral-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 font-medium mr-1 mb-1">${t}</span>`
          )
          .join("");

        const langBadges = (post.languages || [])
          .slice(0, 2)
          .map(
            (l) =>
              `<span class="inline-block px-1.5 py-0.5 text-[10px] rounded bg-mint-500/10 text-mint-600 dark:text-mint-300 font-mono mr-1">${l}</span>`
          )
          .join("");

        const imageThumbnail = post.image_url
          ? `<img src="${post.image_url}" alt="" class="size-10 rounded-lg object-cover bg-neutral-200 dark:bg-zinc-800 shrink-0" />`
          : `<div class="size-10 rounded-lg bg-neutral-100 dark:bg-zinc-800 flex items-center justify-center text-neutral-400 shrink-0 font-bold text-xs">P</div>`;

        return `
          <tr class="hover:bg-neutral-50/50 dark:hover:bg-zinc-800/40 transition-colors">
            <td class="py-4 px-6">
              <div class="flex items-center gap-3">
                ${imageThumbnail}
                <div class="min-w-0">
                  <a href="/admin/posts/edit?id=${post.id}" class="font-semibold text-neutral-900 dark:text-white hover:text-mint-500 dark:hover:text-mint-400 transition-colors block truncate max-w-sm">
                    ${post.title}
                  </a>
                  <span class="text-xs text-neutral-400 font-mono block truncate">
                    /blog/posts/${post.slug}
                  </span>
                  ${post.project ? '<span class="inline-block text-[10px] font-bold text-amber-500 uppercase tracking-wider mt-0.5">⭐ Projeto</span>' : ''}
                </div>
              </div>
            </td>
            <td class="py-4 px-6 whitespace-nowrap text-xs text-neutral-600 dark:text-neutral-400">
              ${post.pub_date || "-"}
            </td>
            <td class="py-4 px-6">
              <div class="flex flex-wrap max-w-xs">
                ${tagsBadges}
                ${langBadges}
              </div>
            </td>
            <td class="py-4 px-6 whitespace-nowrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${
                isPublished
                  ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
                  : "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20"
              }">
                <span class="size-1.5 rounded-full ${isPublished ? "bg-emerald-500" : "bg-amber-500"}"></span>
                ${isPublished ? "Publicado" : "Rascunho"}
              </span>
            </td>
            <td class="py-4 px-6 whitespace-nowrap text-right text-xs font-medium space-x-2">
              <a
                href="/blog/posts/${post.slug}"
                target="_blank"
                title="Ver post"
                class="inline-flex items-center justify-center size-8 rounded-lg text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-zinc-800 transition-all"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </a>
              <a
                href="/admin/posts/edit?id=${post.id}"
                title="Editar post"
                class="inline-flex items-center justify-center size-8 rounded-lg text-mint-500 hover:bg-mint-500/10 transition-all"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </a>
              <button
                data-id="${post.id}"
                data-status="${post.status}"
                class="toggle-status-btn inline-flex items-center justify-center size-8 rounded-lg text-amber-500 hover:bg-amber-500/10 transition-all cursor-pointer"
                title="${isPublished ? 'Mudar para rascunho' : 'Publicar imediatamente'}"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </button>
              <button
                data-id="${post.id}"
                data-title="${post.title.replace(/"/g, '&quot;')}"
                class="delete-post-btn inline-flex items-center justify-center size-8 rounded-lg text-rose-500 hover:bg-rose-500/10 transition-all cursor-pointer"
                title="Excluir post"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </td>
          </tr>
        `;
      })
      .join("");

    attachEventListeners();
  }

  function attachEventListeners() {
    // Toggle Status Button
    document.querySelectorAll(".toggle-status-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id");
        const currentStatus = target.getAttribute("data-status");
        if (!id) return;

        const newStatus = currentStatus === "published" ? "draft" : "published";
        const { error } = await supabase
          .from("posts")
          .update({ status: newStatus, updated_at: new Date().toISOString() })
          .eq("id", id);

        if (error) {
          alert(`Erro ao atualizar status: ${error.message}`);
        } else {
          loadPosts();
        }
      });
    });

    // Delete Button
    document.querySelectorAll(".delete-post-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id");
        const title = target.getAttribute("data-title");
        if (!id) return;

        if (confirm(`Tem certeza que deseja excluir o post:\n"${title}"?`)) {
          const { error } = await supabase.from("posts").delete().eq("id", id);
          if (error) {
            alert(`Erro ao excluir post: ${error.message}`);
          } else {
            loadPosts();
          }
        }
      });
    });
  }

  // Search input handler
  searchInput.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    renderTable();
  });

  // Filter buttons handler
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      filterBtns.forEach((b) => {
        b.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-zinc-800 cursor-pointer";
      });
      target.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 cursor-pointer";
      currentFilter = target.getAttribute("data-filter") || "all";
      renderTable();
    });
  });

  initAuth();
</script>
