---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Studio Admin - Iniciar Sessão";
---

<Layout pageTitle={pageTitle}>
  <div class="min-h-[82vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="relative">
        <!-- Apple Card Container -->
        <div class="relative bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 rounded-3xl p-8 sm:p-9 shadow-[0_4px_30px_rgba(0,0,0,0.04)] dark:shadow-[0_4px_40px_rgba(0,0,0,0.6)]">
          <div class="text-center mb-7">
            <!-- Apple Squircle Emblem -->
            <div class="inline-flex items-center justify-center size-14 rounded-2xl bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-bold text-lg shadow-sm mb-4 tracking-tight">
              BN
            </div>
            <h1 class="text-xl font-bold text-[#1d1d1f] dark:text-white tracking-tight">Studio Admin</h1>
            <p class="text-xs text-[#86868b] dark:text-[#a1a1a6] mt-1 font-medium">Inicie sessão para gerenciar publicações e dados</p>
          </div>

          <div id="authMessage" class="hidden mb-5 p-3.5 rounded-2xl text-xs font-semibold flex items-center gap-2 transition-all"></div>

          <form id="authForm" class="space-y-4">
            <div>
              <label for="email" class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1.5">
                E-mail
              </label>
              <input
                type="email"
                id="email"
                required
                placeholder="nome@exemplo.com"
                class="w-full px-4 py-2.5 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
              />
            </div>

            <div>
              <label for="password" class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1.5">
                Senha
              </label>
              <input
                type="password"
                id="password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-2.5 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
              />
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <label class="flex items-center gap-2 text-[#86868b] dark:text-[#a1a1a6] cursor-pointer text-xs font-medium">
                <input type="checkbox" id="rememberMe" checked class="rounded accent-[#0071e3] size-3.5" />
                Lembrar sessão
              </label>
            </div>

            <button
              type="submit"
              id="submitBtn"
              class="w-full mt-3 py-3 px-4 rounded-full bg-[#0071e3] hover:bg-[#0077ed] active:bg-[#0062c4] text-white font-bold text-xs shadow-sm shadow-[#0071e3]/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="btnText">Entrar no Painel</span>
              <svg id="btnSpinner" class="hidden animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

          <div class="mt-7 pt-5 border-t border-neutral-100 dark:border-white/5 text-center">
            <a
              href="/"
              class="text-xs text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-white transition-colors inline-flex items-center gap-1 font-medium"
            >
              ← Voltar ao Portfólio
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const authForm = document.getElementById("authForm") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const btnSpinner = document.getElementById("btnSpinner") as HTMLElement;
  const authMessage = document.getElementById("authMessage") as HTMLDivElement;

  function showMessage(text: string, type: "error" | "success") {
    authMessage.textContent = text;
    authMessage.className = `mb-5 p-3.5 rounded-2xl text-xs font-semibold flex items-center gap-2 transition-all ${
      type === "error"
        ? "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20"
        : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
    }`;
    authMessage.classList.remove("hidden");
  }

  // Check if user is already logged in
  async function checkActiveSession() {
    const { data } = await supabase.auth.getSession();
    if (data.session) {
      window.location.href = "/admin";
    }
  }
  checkActiveSession();

  authForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !password) return;

    submitBtn.disabled = true;
    btnSpinner.classList.remove("hidden");

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) throw error;

      showMessage("Login realizado! Entrando no painel...", "success");
      setTimeout(() => {
        window.location.href = "/admin";
      }, 800);
    } catch (err: any) {
      console.error(err);
      showMessage(err.message || "Credenciais inválidas. Verifique os dados digitados.", "error");
    } finally {
      submitBtn.disabled = false;
      btnSpinner.classList.add("hidden");
    }
  });
</script>
