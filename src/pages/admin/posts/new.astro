---
import Layout from "../../../layouts/Layout.astro";

const pageTitle = "Criar Publicação | Bernardo Studio";
---

<Layout pageTitle={pageTitle}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[90vh]">
    <!-- Apple-style Navigation Header -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-neutral-200/70 dark:border-white/10">
      <div>
        <div class="flex items-center gap-2 text-xs text-[#86868b] dark:text-[#a1a1a6] mb-1 font-medium">
          <a href="/admin#posts" class="hover:text-[#0071e3] transition-colors flex items-center gap-1">
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Painel Studio
          </a>
          <span>/</span>
          <span class="text-[#1d1d1f] dark:text-white font-semibold">Novo Artigo</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#1d1d1f] dark:text-white">
          Criar Nova Publicação
        </h1>
      </div>

      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        <a
          href="/admin#posts"
          class="flex-1 sm:flex-none text-center px-4 py-2 rounded-full border border-neutral-300/80 dark:border-white/15 text-xs font-semibold text-[#1d1d1f] dark:text-white hover:bg-neutral-100 dark:hover:bg-white/5 active:scale-[0.98] transition-all"
        >
          Cancelar
        </a>
        <button
          type="button"
          id="saveDraftBtn"
          class="flex-1 sm:flex-none px-4 py-2 rounded-full bg-amber-500/10 hover:bg-amber-500/15 border border-amber-500/20 text-xs font-semibold text-amber-600 dark:text-amber-400 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>Salvar Rascunho</span>
        </button>
        <button
          type="button"
          id="publishBtn"
          class="flex-1 sm:flex-none px-5 py-2 rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-bold shadow-sm shadow-[#0071e3]/20 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-1.5"
        >
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span id="publishBtnText">Publicar Post</span>
        </button>
      </div>
    </header>

    <!-- Global Toast Alert -->
    <div id="statusAlert" class="hidden my-4 p-4 rounded-2xl text-xs font-semibold flex items-center gap-2.5 transition-all"></div>

    <!-- Main Post Form -->
    <form id="postForm" class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-6">
      <!-- Left Column: Content & Markdown (2 cols) -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Title Input -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <div>
            <label for="postTitle" class="block text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider mb-2">
              Título da Publicação *
            </label>
            <input
              type="text"
              id="postTitle"
              required
              placeholder="Ex: Análise Preditiva em Saúde com Machine Learning"
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-base font-semibold text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
            />
          </div>

          <!-- Apple Smart Slug Controller -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="postSlug" class="block text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
                Slug URL (Identificador) *
              </label>
              <button
                type="button"
                id="slugToggleBtn"
                class="text-[11px] font-semibold text-[#0071e3] hover:underline flex items-center gap-1 cursor-pointer"
              >
                <span id="slugModeIcon">⚡</span>
                <span id="slugModeText">Automático (ativo)</span>
              </button>
            </div>
            <div class="flex items-center rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 px-4 py-2.5 transition-all focus-within:ring-2 focus-within:ring-[#0071e3]/20 focus-within:border-[#0071e3]">
              <span class="text-xs text-[#86868b] font-mono select-none">/blog/posts/</span>
              <input
                type="text"
                id="postSlug"
                required
                placeholder="slug-gerado-automaticamente"
                class="w-full bg-transparent text-xs font-mono font-medium text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none pl-1"
              />
            </div>
            <p id="slugHint" class="text-[11px] text-[#86868b] mt-1">
              O slug é gerado instantaneamente conforme você digita o título.
            </p>
          </div>

          <!-- Description Input -->
          <div>
            <label for="postDescription" class="block text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider mb-2">
              Resumo / Meta Descrição
            </label>
            <textarea
              id="postDescription"
              rows="2"
              placeholder="Breve resumo para os cartões de prévia e meta tags de SEO..."
              class="w-full px-4 py-2.5 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
            ></textarea>
          </div>
        </div>

        <!-- Markdown Editor & Preview Card -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
              Conteúdo em Markdown *
            </label>

            <!-- Apple Segmented Control for Editor/Preview -->
            <div class="p-1 bg-neutral-100 dark:bg-zinc-800/80 rounded-xl flex items-center gap-1">
              <button
                type="button"
                id="tabEditorBtn"
                class="px-3.5 py-1 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs cursor-pointer transition-all"
              >
                Editor
              </button>
              <button
                type="button"
                id="tabPreviewBtn"
                class="px-3.5 py-1 rounded-lg text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white cursor-pointer transition-all"
              >
                Pré-visualização
              </button>
            </div>
          </div>

          <!-- Markdown Toolbar -->
          <div id="toolbar" class="flex flex-wrap items-center justify-between gap-1.5 p-2 bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 rounded-2xl">
            <div class="flex flex-wrap items-center gap-1">
              <button type="button" data-cmd="bold" class="tool-btn px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Negrito">B</button>
              <button type="button" data-cmd="italic" class="tool-btn px-2.5 py-1 text-xs italic font-serif rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Itálico">I</button>
              <button type="button" data-cmd="heading" class="tool-btn px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Título H2">H2</button>
              <button type="button" data-cmd="h3" class="tool-btn px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Título H3">H3</button>
              <button type="button" data-cmd="code" class="tool-btn px-2.5 py-1 text-xs font-mono rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Código">&lt;/&gt;</button>
              <button type="button" data-cmd="table" class="tool-btn px-2.5 py-1 text-xs rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Tabela">Tabela</button>
              <button type="button" data-cmd="link" class="tool-btn px-2.5 py-1 text-xs rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Link">Link</button>
              <button type="button" data-cmd="quote" class="tool-btn px-2.5 py-1 text-xs rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#1d1d1f] dark:text-white transition-colors" title="Citação">” Citação</button>
              <span class="w-px h-4 bg-neutral-300 dark:bg-zinc-700 mx-1"></span>
              <button type="button" id="insertGifBtn" class="px-2.5 py-1 text-xs font-semibold rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-[#0071e3] transition-colors flex items-center gap-1" title="Inserir GIF ou Imagem no texto">
                <span>🖼️ GIF/Imagem</span>
              </button>
              <button type="button" id="insertYoutubeBtn" class="px-2.5 py-1 text-xs font-semibold rounded-lg hover:bg-neutral-200 dark:hover:bg-zinc-700 text-rose-500 transition-colors flex items-center gap-1" title="Inserir Vídeo do YouTube">
                <span>🎬 YouTube</span>
              </button>
            </div>
            <div>
              <button type="button" id="toggleMediaHelpBtn" class="px-2.5 py-1 text-[11px] font-semibold text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-white rounded-lg transition-colors flex items-center gap-1 cursor-pointer">
                <span>💡 Como usar GIF & Vídeo</span>
              </button>
            </div>
          </div>

          <!-- Media Tips Accordion Box (Hidden by default) -->
          <div id="mediaHelpBox" class="hidden p-4 rounded-2xl bg-neutral-100/90 dark:bg-zinc-850 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-neutral-200 space-y-2">
            <div class="flex items-center justify-between font-bold text-xs">
              <span class="flex items-center gap-1.5 text-[#0071e3]">💡 Dicas para inserir GIFs e Vídeos ao longo do texto</span>
              <button type="button" id="closeMediaHelpBtn" class="text-neutral-400 hover:text-black dark:hover:text-white text-base cursor-pointer">&times;</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-[11px] leading-relaxed pt-1">
              <div class="p-3 rounded-xl bg-white dark:bg-zinc-900 border border-neutral-200/60 dark:border-white/5 space-y-1">
                <p class="font-bold text-[#1d1d1f] dark:text-white">🖼️ Como colocar GIFs:</p>
                <p class="text-neutral-500 dark:text-neutral-400">Use a sintaxe padrão de imagem do Markdown com o link direto do GIF (ex: Giphy, Tenor ou upload):</p>
                <code class="block p-1.5 rounded-lg bg-neutral-100 dark:bg-zinc-800 font-mono text-[10px] select-all overflow-x-auto">![Legenda animada](https://media.giphy.com/media/.../giphy.gif)</code>
              </div>
              <div class="p-3 rounded-xl bg-white dark:bg-zinc-900 border border-neutral-200/60 dark:border-white/5 space-y-1">
                <p class="font-bold text-[#1d1d1f] dark:text-white">🎬 Como colocar Vídeos do YouTube:</p>
                <p class="text-neutral-500 dark:text-neutral-400">Basta clicar no botão <strong>🎬 YouTube</strong> acima e colar o link do vídeo, ou usar a tag responsiva:</p>
                <code class="block p-1.5 rounded-lg bg-neutral-100 dark:bg-zinc-800 font-mono text-[10px] select-all overflow-x-auto">&lt;div class="video-responsive"&gt;&lt;iframe src="https://www.youtube.com/embed/VIDEO_ID" allowfullscreen&gt;&lt;/iframe&gt;&lt;/div&gt;</code>
              </div>
            </div>
          </div>

          <!-- Editor Textarea -->
          <div id="editorContainer">
            <textarea
              id="postContent"
              rows="18"
              required
              placeholder="Escreva seu artigo aqui usando Markdown..."
              class="w-full px-4 py-3 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 font-mono text-xs leading-relaxed text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all resize-y"
            ></textarea>
          </div>

          <!-- Live Preview -->
          <div
            id="previewContainer"
            class="hidden w-full min-h-[380px] max-h-[600px] overflow-y-auto px-6 py-6 rounded-2xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 prose dark:prose-invert max-w-none text-[#1d1d1f] dark:text-neutral-100 text-xs leading-relaxed"
          >
            <div id="previewOutput"></div>
          </div>
        </div>
      </div>

      <!-- Right Column: Metadata, Media & Selectable Tags/Techs -->
      <div class="space-y-6">
        <!-- Settings Card -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
            Publicação
          </h3>

          <div>
            <label for="postDate" class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">Data</label>
            <input
              type="date"
              id="postDate"
              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white"
            />
          </div>

          <div>
            <label for="postAuthor" class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1">Autor</label>
            <input
              type="text"
              id="postAuthor"
              value="Bernardo Nogueira"
              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white"
            />
          </div>

          <div>
            <label for="postMediumUrl" class="block text-xs font-semibold text-[#1d1d1f] dark:text-[#e5e5ea] mb-1 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <svg class="size-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
                Link no Medium (Opcional)
              </span>
              <span class="text-[10px] text-[#86868b] font-normal">Cross-post</span>
            </label>
            <input
              type="url"
              id="postMediumUrl"
              placeholder="https://medium.com/@bernardonogueira8/..."
              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs font-medium text-[#1d1d1f] dark:text-white placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#0071e3]/20 focus:border-[#0071e3] transition-all"
            />
          </div>

          <div class="pt-2 flex items-center justify-between border-t border-neutral-100 dark:border-white/5">
            <div>
              <span class="text-xs font-bold text-[#1d1d1f] dark:text-white block">Destacar como Projeto</span>
              <span class="text-[11px] text-[#86868b]">Exibir na grade de Projetos da Home</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="postIsProject" class="sr-only peer" />
              <div class="w-10 h-6 bg-neutral-300 dark:bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#0071e3]"></div>
            </label>
          </div>
        </div>

        <!-- Cover Image Card -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
            Imagem de Capa
          </h3>

          <div id="imagePreviewBox" class="hidden mb-3">
            <div class="relative rounded-2xl overflow-hidden border border-neutral-200 dark:border-white/10 aspect-video bg-neutral-100 dark:bg-zinc-800">
              <img id="imagePreview" src="" alt="Capa" class="size-full object-cover" />
              <button
                type="button"
                id="removeImageBtn"
                class="absolute top-2 right-2 size-7 rounded-full bg-black/60 hover:bg-black text-white text-xs flex items-center justify-center backdrop-blur-xs cursor-pointer transition-all"
                title="Remover imagem"
              >
                &times;
              </button>
            </div>
          </div>

          <div>
            <label class="block w-full py-3 px-3 rounded-2xl border border-dashed border-neutral-300 dark:border-white/20 hover:border-[#0071e3] text-center cursor-pointer transition-colors bg-neutral-50/50 dark:bg-zinc-900/40">
              <span class="text-xs font-semibold text-[#1d1d1f] dark:text-neutral-300">📁 Fazer Upload de Imagem</span>
              <input type="file" id="imageFileInput" accept="image/*" class="hidden" />
            </label>
            <span id="uploadProgress" class="text-[11px] text-[#0071e3] hidden mt-1 block font-medium">Enviando imagem...</span>
          </div>

          <div>
            <label for="imageUrl" class="block text-[11px] font-semibold text-[#86868b] mb-1">Ou cole uma URL da Imagem</label>
            <input
              type="text"
              id="imageUrl"
              placeholder="https://... ou /attachments/..."
              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
            />
          </div>

          <div>
            <label for="imageAlt" class="block text-[11px] font-semibold text-[#86868b] mb-1">Texto Alternativo (Acessibilidade)</label>
            <input
              type="text"
              id="imageAlt"
              placeholder="Descrição da imagem para leitores de tela"
              class="w-full px-3 py-2 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
            />
          </div>
        </div>

        <!-- Interactive Chip Selector: Tecnologias -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
              Tecnologias & Frameworks
            </h3>
            <span id="techSelectedCount" class="text-[11px] font-semibold text-[#0071e3]">0 selecionadas</span>
          </div>

          <p class="text-[11px] text-[#86868b]">
            Clique nas tecnologias para adicioná-las ao artigo:
          </p>

          <!-- Selectable Chips Container -->
          <div id="techChipsContainer" class="flex flex-wrap gap-1.5 max-h-48 overflow-y-auto pr-1">
            <span class="text-xs text-neutral-400">Carregando tecnologias...</span>
          </div>

          <!-- Add Custom Tech Input -->
          <div class="flex gap-2 pt-2 border-t border-neutral-100 dark:border-white/5">
            <input
              type="text"
              id="customTechInput"
              placeholder="Outra tecnologia..."
              class="flex-1 px-3 py-1.5 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
            />
            <button
              type="button"
              id="addCustomTechBtn"
              class="px-3 py-1.5 rounded-xl bg-neutral-200 dark:bg-zinc-700 text-xs font-bold text-[#1d1d1f] dark:text-white hover:bg-neutral-300 dark:hover:bg-zinc-600 transition-colors cursor-pointer"
            >
              +
            </button>
          </div>
        </div>

        <!-- Interactive Chip Selector: Categorias / Tags -->
        <div class="p-6 rounded-3xl bg-white/80 dark:bg-[#121215]/80 backdrop-blur-2xl border border-neutral-200/70 dark:border-white/10 shadow-[0_2px_16px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.5)] space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-[#6e6e73] dark:text-[#a1a1a6] uppercase tracking-wider">
              Categorias & Tags
            </h3>
            <span id="tagSelectedCount" class="text-[11px] font-semibold text-[#0071e3]">0 selecionadas</span>
          </div>

          <p class="text-[11px] text-[#86868b]">
            Clique para selecionar ou adicione novas tags:
          </p>

          <!-- Selectable Chips Container -->
          <div id="tagChipsContainer" class="flex flex-wrap gap-1.5 max-h-48 overflow-y-auto pr-1">
            <span class="text-xs text-neutral-400">Carregando tags...</span>
          </div>

          <!-- Add Custom Tag Input -->
          <div class="flex gap-2 pt-2 border-t border-neutral-100 dark:border-white/5">
            <input
              type="text"
              id="customTagInput"
              placeholder="Nova tag..."
              class="flex-1 px-3 py-1.5 rounded-xl bg-neutral-50 dark:bg-zinc-900/60 border border-neutral-200/80 dark:border-white/10 text-xs text-[#1d1d1f] dark:text-white"
            />
            <button
              type="button"
              id="addCustomTagBtn"
              class="px-3 py-1.5 rounded-xl bg-neutral-200 dark:bg-zinc-700 text-xs font-bold text-[#1d1d1f] dark:text-white hover:bg-neutral-300 dark:hover:bg-zinc-600 transition-colors cursor-pointer"
            >
              +
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { supabase, type TechStackItem } from "../../../lib/supabase";
  import { marked } from "marked";

  // Elements
  const postForm = document.getElementById("postForm") as HTMLFormElement;
  const titleInput = document.getElementById("postTitle") as HTMLInputElement;
  const slugInput = document.getElementById("postSlug") as HTMLInputElement;
  const slugToggleBtn = document.getElementById("slugToggleBtn") as HTMLButtonElement;
  const slugModeIcon = document.getElementById("slugModeIcon") as HTMLElement;
  const slugModeText = document.getElementById("slugModeText") as HTMLElement;
  const slugHint = document.getElementById("slugHint") as HTMLElement;

  const descriptionInput = document.getElementById("postDescription") as HTMLTextAreaElement;
  const contentInput = document.getElementById("postContent") as HTMLTextAreaElement;
  const dateInput = document.getElementById("postDate") as HTMLInputElement;
  const authorInput = document.getElementById("postAuthor") as HTMLInputElement;
  const isProjectInput = document.getElementById("postIsProject") as HTMLInputElement;
  const postMediumUrl = document.getElementById("postMediumUrl") as HTMLInputElement;
  const imageUrlInput = document.getElementById("imageUrl") as HTMLInputElement;
  const imageAltInput = document.getElementById("imageAlt") as HTMLInputElement;
  const imageFileInput = document.getElementById("imageFileInput") as HTMLInputElement;
  const imagePreview = document.getElementById("imagePreview") as HTMLImageElement;
  const imagePreviewBox = document.getElementById("imagePreviewBox") as HTMLElement;
  const removeImageBtn = document.getElementById("removeImageBtn") as HTMLButtonElement;
  const uploadProgress = document.getElementById("uploadProgress") as HTMLElement;

  const techChipsContainer = document.getElementById("techChipsContainer") as HTMLElement;
  const customTechInput = document.getElementById("customTechInput") as HTMLInputElement;
  const addCustomTechBtn = document.getElementById("addCustomTechBtn") as HTMLButtonElement;
  const techSelectedCount = document.getElementById("techSelectedCount") as HTMLElement;

  const tagChipsContainer = document.getElementById("tagChipsContainer") as HTMLElement;
  const customTagInput = document.getElementById("customTagInput") as HTMLInputElement;
  const addCustomTagBtn = document.getElementById("addCustomTagBtn") as HTMLButtonElement;
  const tagSelectedCount = document.getElementById("tagSelectedCount") as HTMLElement;

  const tabEditorBtn = document.getElementById("tabEditorBtn") as HTMLButtonElement;
  const tabPreviewBtn = document.getElementById("tabPreviewBtn") as HTMLButtonElement;
  const editorContainer = document.getElementById("editorContainer") as HTMLElement;
  const previewContainer = document.getElementById("previewContainer") as HTMLElement;
  const previewOutput = document.getElementById("previewOutput") as HTMLElement;

  const insertGifBtn = document.getElementById("insertGifBtn") as HTMLButtonElement;
  const insertYoutubeBtn = document.getElementById("insertYoutubeBtn") as HTMLButtonElement;
  const toggleMediaHelpBtn = document.getElementById("toggleMediaHelpBtn") as HTMLButtonElement;
  const closeMediaHelpBtn = document.getElementById("closeMediaHelpBtn") as HTMLButtonElement;
  const mediaHelpBox = document.getElementById("mediaHelpBox") as HTMLElement;

  const publishBtn = document.getElementById("publishBtn") as HTMLButtonElement;
  const saveDraftBtn = document.getElementById("saveDraftBtn") as HTMLButtonElement;
  const statusAlert = document.getElementById("statusAlert") as HTMLElement;

  // Selected State
  let selectedLanguages: string[] = [];
  let availableTechnologies: { name: string; key: string }[] = [];

  let selectedTags: string[] = [];
  let availableTags: string[] = [
    "Ciência de Dados",
    "Machine Learning",
    "Python",
    "Power BI",
    "Estatística",
    "Inteligência Artificial",
    "Saúde",
    "Projetos",
    "SQL",
    "Deep Learning",
    "Engenharia de Dados",
    "Tutorial",
  ];

  // Set today's date by default
  dateInput.value = new Date().toISOString().split("T")[0];

  // Auth check
  async function initAuth() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = "/admin/login";
      return;
    }
    loadAvailableTechsAndTags();
  }

  // Slug auto-generation with Apple-style Lock/Unlock
  let isAutoSlug = true;

  function slugify(text: string): string {
    return text
      .toString()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^\w\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .replace(/--+/g, "-");
  }

  titleInput.addEventListener("input", () => {
    if (isAutoSlug) {
      slugInput.value = slugify(titleInput.value);
    }
  });

  slugInput.addEventListener("input", () => {
    // If the user manually edits the slug input, switch to manual mode
    if (isAutoSlug) {
      setAutoSlugMode(false);
    }
  });

  function setAutoSlugMode(auto: boolean) {
    isAutoSlug = auto;
    if (auto) {
      slugModeIcon.textContent = "⚡";
      slugModeText.textContent = "Automático (ativo)";
      slugHint.textContent = "O slug é gerado instantaneamente conforme você digita o título.";
      slugInput.value = slugify(titleInput.value);
    } else {
      slugModeIcon.textContent = "✏️";
      slugModeText.textContent = "Personalizado (clique para reativar auto)";
      slugHint.textContent = "Você está editando o slug manualmente.";
    }
  }

  slugToggleBtn.addEventListener("click", () => {
    setAutoSlugMode(!isAutoSlug);
  });

  // Load Technologies and Tags from Supabase
  async function loadAvailableTechsAndTags() {
    try {
      // 1. Tech stack
      const { data: techData } = await supabase
        .from("tech_stack")
        .select("name, key")
        .order("order_index", { ascending: true });

      if (techData && techData.length > 0) {
        availableTechnologies = techData;
      } else {
        availableTechnologies = [
          { name: "Power BI", key: "power" },
          { name: "Python", key: "python" },
          { name: "SQL", key: "sql" },
          { name: "Pandas", key: "pandas" },
          { name: "Numpy", key: "numpy" },
          { name: "Seaborn", key: "seaborn" },
          { name: "Matplotlib", key: "matplotlib" },
          { name: "MySQL", key: "mysql" },
          { name: "PHP", key: "php" },
          { name: "Git", key: "git" },
          { name: "Figma", key: "figma" },
          { name: "Markdown", key: "markdown" },
        ];
      }

      // 2. Tags from posts
      const { data: postsData } = await supabase.from("posts").select("tags");
      if (postsData) {
        postsData.forEach((p) => {
          (p.tags || []).forEach((t: string) => {
            if (t && !availableTags.includes(t)) availableTags.push(t);
          });
        });
      }

      renderTechChips();
      renderTagChips();
    } catch (err) {
      console.error("Erro ao carregar tags/techs:", err);
      renderTechChips();
      renderTagChips();
    }
  }

  // Render Tech Chips
  function renderTechChips() {
    techSelectedCount.textContent = `${selectedLanguages.length} selecionada${selectedLanguages.length === 1 ? "" : "s"}`;
    techChipsContainer.innerHTML = availableTechnologies
      .map((t) => {
        const isSelected = selectedLanguages.includes(t.key);
        return `
          <button
            type="button"
            data-key="${t.key}"
            class="tech-chip px-3 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${
              isSelected
                ? "bg-[#1d1d1f] text-white dark:bg-white dark:text-[#1d1d1f] shadow-xs scale-102"
                : "bg-neutral-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-zinc-700"
            }"
          >
            ${isSelected ? "✓" : "+"}
            <span>${t.name}</span>
          </button>
        `;
      })
      .join("");

    document.querySelectorAll(".tech-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-key");
        if (!key) return;
        if (selectedLanguages.includes(key)) {
          selectedLanguages = selectedLanguages.filter((l) => l !== key);
        } else {
          selectedLanguages.push(key);
        }
        renderTechChips();
      });
    });
  }

  function addCustomTech() {
    const val = customTechInput.value.trim().toLowerCase();
    if (!val) return;
    const key = slugify(val);
    if (!availableTechnologies.some((t) => t.key === key)) {
      availableTechnologies.push({ name: val.charAt(0).toUpperCase() + val.slice(1), key });
    }
    if (!selectedLanguages.includes(key)) {
      selectedLanguages.push(key);
    }
    customTechInput.value = "";
    renderTechChips();
  }

  addCustomTechBtn.addEventListener("click", addCustomTech);
  customTechInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addCustomTech();
    }
  });

  // Render Tag Chips
  function renderTagChips() {
    tagSelectedCount.textContent = `${selectedTags.length} selecionada${selectedTags.length === 1 ? "" : "s"}`;
    tagChipsContainer.innerHTML = availableTags
      .map((t) => {
        const isSelected = selectedTags.includes(t);
        return `
          <button
            type="button"
            data-tag="${t}"
            class="tag-chip px-3 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${
              isSelected
                ? "bg-[#0071e3] text-white shadow-xs scale-102"
                : "bg-neutral-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-zinc-700"
            }"
          >
            ${isSelected ? "✓" : "+"}
            <span>${t}</span>
          </button>
        `;
      })
      .join("");

    document.querySelectorAll(".tag-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.getAttribute("data-tag");
        if (!tag) return;
        if (selectedTags.includes(tag)) {
          selectedTags = selectedTags.filter((x) => x !== tag);
        } else {
          selectedTags.push(tag);
        }
        renderTagChips();
      });
    });
  }

  function addCustomTag() {
    const val = customTagInput.value.trim();
    if (!val) return;
    if (!availableTags.includes(val)) {
      availableTags.push(val);
    }
    if (!selectedTags.includes(val)) {
      selectedTags.push(val);
    }
    customTagInput.value = "";
    renderTagChips();
  }

  addCustomTagBtn.addEventListener("click", addCustomTag);
  customTagInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addCustomTag();
    }
  });

  // Image Upload & Preview
  imageUrlInput.addEventListener("input", () => {
    const val = imageUrlInput.value.trim();
    if (val) {
      imagePreview.src = val;
      imagePreviewBox.classList.remove("hidden");
    } else {
      imagePreviewBox.classList.add("hidden");
    }
  });

  removeImageBtn.addEventListener("click", () => {
    imageUrlInput.value = "";
    imagePreview.src = "";
    imagePreviewBox.classList.add("hidden");
    imageFileInput.value = "";
  });

  imageFileInput.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    uploadProgress.classList.remove("hidden");
    uploadProgress.textContent = "Enviando para o Supabase Storage...";

    const fileExt = file.name.split(".").pop();
    const fileName = `${Date.now()}-${Math.random().toString(36).substring(2, 8)}.${fileExt}`;
    const filePath = `posts/${fileName}`;

    try {
      const { error } = await supabase.storage.from("blog-images").upload(filePath, file, { upsert: true });
      if (error) throw error;

      const { data: publicUrlData } = supabase.storage.from("blog-images").getPublicUrl(filePath);

      imageUrlInput.value = publicUrlData.publicUrl;
      imagePreview.src = publicUrlData.publicUrl;
      imagePreviewBox.classList.remove("hidden");
      uploadProgress.textContent = "Upload concluído com sucesso!";
      setTimeout(() => uploadProgress.classList.add("hidden"), 3000);
    } catch (err: any) {
      uploadProgress.textContent = `Erro no upload: ${err.message}`;
    }
  });

  // Editor vs Preview Tabs
  tabEditorBtn.addEventListener("click", () => {
    tabEditorBtn.className = "px-3.5 py-1 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs cursor-pointer transition-all";
    tabPreviewBtn.className = "px-3.5 py-1 rounded-lg text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white cursor-pointer transition-all";
    editorContainer.classList.remove("hidden");
    previewContainer.classList.add("hidden");
  });

  tabPreviewBtn.addEventListener("click", async () => {
    tabPreviewBtn.className = "px-3.5 py-1 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-[#1d1d1f] dark:text-white shadow-xs cursor-pointer transition-all";
    tabEditorBtn.className = "px-3.5 py-1 rounded-lg text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-white cursor-pointer transition-all";
    editorContainer.classList.add("hidden");
    previewContainer.classList.remove("hidden");
    previewOutput.innerHTML = (await marked.parse(contentInput.value || "*Nenhum conteúdo para pré-visualizar ainda...*")) as string;
  });

  // Markdown Toolbar
  document.querySelectorAll(".tool-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      const start = contentInput.selectionStart;
      const end = contentInput.selectionEnd;
      const text = contentInput.value;
      const selected = text.substring(start, end);

      let insert = "";
      switch (cmd) {
        case "bold":
          insert = `**${selected || "texto em negrito"}**`;
          break;
        case "italic":
          insert = `*${selected || "texto em itálico"}*`;
          break;
        case "heading":
          insert = `\n## ${selected || "Título da Seção"}\n`;
          break;
        case "h3":
          insert = `\n### ${selected || "Subtítulo"}\n`;
          break;
        case "code":
          insert = `\n\`\`\`python\n${selected || "# Código aqui"}\n\`\`\`\n`;
          break;
        case "table":
          insert = `\n| Coluna 1 | Coluna 2 |\n| :--- | :--- |\n| Dado 1 | Dado 2 |\n`;
          break;
        case "link":
          insert = `[${selected || "Texto do link"}](https://exemplo.com)`;
          break;
        case "quote":
          insert = `\n> ${selected || "Citação inspiradora"}\n`;
          break;
      }

      contentInput.setRangeText(insert, start, end, "end");
      contentInput.focus();
    });
  });

  // Media Help Toggle
  toggleMediaHelpBtn?.addEventListener("click", () => {
    mediaHelpBox.classList.toggle("hidden");
  });
  closeMediaHelpBtn?.addEventListener("click", () => {
    mediaHelpBox.classList.add("hidden");
  });

  // Extract YouTube ID from multiple formats
  function extractYouTubeId(url: string): string | null {
    if (!url) return null;
    url = url.trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return url;
    const matchWatch = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
    if (matchWatch) return matchWatch[1];
    const matchShort = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
    if (matchShort) return matchShort[1];
    const matchEmbed = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]{11})/);
    if (matchEmbed) return matchEmbed[1];
    const matchShorts = url.match(/youtube\.com\/shorts\/([a-zA-Z0-9_-]{11})/);
    if (matchShorts) return matchShorts[1];
    return null;
  }

  // Insert GIF / Image Dialog
  insertGifBtn?.addEventListener("click", () => {
    const url = prompt("Cole a URL direta do GIF ou da Imagem (ex: Giphy, Tenor ou Supabase Storage):");
    if (!url || !url.trim()) return;
    const caption = prompt("Legenda ou descrição acessível do GIF (opcional):") || "Demonstração animada";
    const snippet = `\n![${caption}](${url.trim()})\n`;
    const start = contentInput.selectionStart;
    const end = contentInput.selectionEnd;
    contentInput.setRangeText(snippet, start, end, "end");
    contentInput.focus();
  });

  // Insert YouTube Video Embed
  insertYoutubeBtn?.addEventListener("click", () => {
    const input = prompt("Cole o link ou ID do vídeo do YouTube (ex: https://www.youtube.com/watch?v=... ou https://youtu.be/...):");
    if (!input || !input.trim()) return;
    const videoId = extractYouTubeId(input);
    if (!videoId) {
      alert("Não foi possível identificar o ID do vídeo do YouTube. Por favor, verifique o link digitado.");
      return;
    }
    const snippet = `\n<div class="video-responsive">\n  <iframe src="https://www.youtube.com/embed/${videoId}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>\n</div>\n`;
    const start = contentInput.selectionStart;
    const end = contentInput.selectionEnd;
    contentInput.setRangeText(snippet, start, end, "end");
    contentInput.focus();
  });

  // Save / Publish
  async function savePost(status: "published" | "draft") {
    const title = titleInput.value.trim();
    const slug = slugInput.value.trim();
    const content = contentInput.value;

    if (!title) {
      showAlert("Por favor, informe o título da publicação.", true);
      titleInput.focus();
      return;
    }
    if (!slug) {
      showAlert("Por favor, informe o slug da publicação.", true);
      slugInput.focus();
      return;
    }
    if (!content) {
      showAlert("O conteúdo em Markdown não pode estar vazio.", true);
      contentInput.focus();
      return;
    }

    publishBtn.disabled = true;
    saveDraftBtn.disabled = true;
    showAlert("Gravando publicação no Supabase...", false);

    const postPayload = {
      title,
      slug,
      content,
      description: descriptionInput.value.trim(),
      pub_date: dateInput.value || new Date().toISOString().split("T")[0],
      author: authorInput.value.trim() || "Bernardo Nogueira",
      project: isProjectInput.checked,
      image_url: imageUrlInput.value.trim() || null,
      image_alt: imageAltInput.value.trim() || null,
      medium_url: postMediumUrl.value.trim() || null,
      tags: selectedTags,
      languages: selectedLanguages,
      status,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    };

    try {
      const { data, error } = await supabase
        .from("posts")
        .insert([postPayload])
        .select()
        .single();

      if (error) {
        if (error.code === "23505") {
          throw new Error("Já existe uma publicação com esse Slug URL. Altere o slug.");
        }
        throw error;
      }

      showAlert(`Publicação ${status === "published" ? "publicada" : "salva como rascunho"} com sucesso! Redirecionando...`, false);
      setTimeout(() => {
        window.location.href = "/admin#posts";
      }, 1200);
    } catch (err: any) {
      showAlert(`Erro ao salvar: ${err.message}`, true);
      publishBtn.disabled = false;
      saveDraftBtn.disabled = false;
    }
  }

  function showAlert(msg: string, isError: boolean) {
    statusAlert.textContent = msg;
    statusAlert.className = `my-4 p-4 rounded-2xl text-xs font-semibold flex items-center gap-2.5 transition-all ${
      isError
        ? "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20"
        : "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
    }`;
  }

  publishBtn.addEventListener("click", () => savePost("published"));
  saveDraftBtn.addEventListener("click", () => savePost("draft"));

  initAuth();
</script>
