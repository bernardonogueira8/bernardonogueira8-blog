---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/portfolio/Contact.astro";
import { getProfile } from "../lib/profile";
import { getCertificatesStore, calculateTotalHours } from "../lib/certificates";

const profile = await getProfile();
const { items: certificates, meta } = await getCertificatesStore();

const formacoes = certificates.filter((c) => c.category === "formacao");
const eventos = certificates.filter((c) => c.category === "evento");
const cursos = certificates.filter((c) => c.category === "curso");
const totalHours = calculateTotalHours(certificates);

// Extrair lista de anos únicos ordenados decrescentemente
const yearsSet = new Set<string>();
certificates.forEach((c) => {
  const matches = c.event_date.match(/\b(20\d{2})\b/g);
  if (matches) matches.forEach((y) => yearsSet.add(y));
});
const availableYears = Array.from(yearsSet).sort().reverse();

const pageTitle = `Certificados — ${meta.title_main} ${meta.title_accent} | ${profile.profile_name || "Bernardo Nogueira"}`;
const pageDescription = meta.description;
const profileImage = profile.profile_image || "/profile.png";
const profileName = profile.profile_name || "Bernardo Nogueira";
const lattesUrl = meta.lattes_url || "http://lattes.cnpq.br/";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

<Layout
  pageTitle={pageTitle}
  description={pageDescription}
  ogimage={{ url: profileImage, alt: `Acervo de Certificados de ${profileName}` }}
>
  <div
    id="certPageRoot"
    data-profile-name={profileName}
    class="diorama-archive relative min-h-screen selection:bg-[#d6ad6e] selection:text-[#090807]"
  >
    <!-- Subtle Film Grain Overlay -->
    <div class="diorama-grain pointer-events-none fixed inset-0 z-30 opacity-[0.035] dark:opacity-[0.055]" aria-hidden="true"></div>

    <!-- Floating Feedback Toast (ABNT / Ações) -->
    <div
      id="abntToast"
      class="hidden fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-full bg-zinc-900/95 dark:bg-white/95 text-white dark:text-zinc-900 text-xs font-mono font-medium shadow-2xl border border-white/10 dark:border-black/10 backdrop-blur-md flex items-center gap-2 transition-all"
    >
      <span class="text-[#d6ad6e]">✓</span>
      <span id="abntToastText">Citação ABNT copiada para a área de transferência!</span>
    </div>

    <!-- ===================================================== -->
    <!-- STAGE 3D INTERATIVO COMPACTO (FRACTAL ESPONJA DE MENGER) -->
    <!-- ===================================================== -->
    <section
      id="dioramaStage"
      class="relative w-full min-h-[250px] sm:min-h-[280px] lg:min-h-[305px] flex flex-col justify-between overflow-hidden border-b border-black/10 dark:border-white/10"
      aria-label="Cena 3D Interativa — Esponja de Menger Fractal"
    >
      <!-- WebGL Canvas (Menger Sponge Fractal) -->
      <canvas
        id="dioramaCanvas"
        class="absolute inset-0 w-full h-full block z-0 cursor-grab active:cursor-grabbing"
        aria-hidden="true"
      ></canvas>

      <!-- Radial Atmospheric Vignette -->
      <div
        class="pointer-events-none absolute inset-0 z-1 bg-[radial-gradient(circle_at_70%_50%,transparent_14%,rgba(247,245,240,0.86)_82%)] dark:bg-[radial-gradient(circle_at_70%_50%,transparent_14%,rgba(11,10,9,0.92)_82%)]"
      ></div>

      <!-- Top Utility Bar: Lattes CNPq, ABNT, PDF & Status -->
      <div class="relative z-10 pointer-events-none max-w-7xl w-full mx-auto px-6 sm:px-10 pt-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-[#d6ad6e] shadow-[0_0_10px_#d6ad6e]"></span>
          <span class="font-mono text-[11px] tracking-[0.14em] text-zinc-600 dark:text-[#8f8577]">
            {profileName} · Currículo Lattes
          </span>
        </div>

        <!-- Ações Acadêmicas (Melhorias 3 e 4) -->
        <div class="pointer-events-auto flex flex-wrap items-center gap-2 sm:gap-3">
          <a
            id="heroLattesLink"
            href={lattesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[10px] tracking-[0.1em] px-2.5 py-1 border border-black/15 dark:border-white/15 text-zinc-800 dark:text-[#ece4d6] hover:border-[#d6ad6e] hover:text-[#d6ad6e] transition-colors cursor-pointer bg-white/40 dark:bg-black/30 backdrop-blur-md inline-flex items-center gap-1"
            title="Acessar currículo oficial do CNPq"
          >
            <span>Lattes CNPq</span>
            <span class="text-xs">↗</span>
          </a>

          <button
            type="button"
            id="copyAbntBtn"
            class="font-mono text-[10px] tracking-[0.1em] px-2.5 py-1 border border-black/15 dark:border-white/15 text-zinc-800 dark:text-[#ece4d6] hover:border-[#d6ad6e] hover:text-[#d6ad6e] transition-colors cursor-pointer bg-white/40 dark:bg-black/30 backdrop-blur-md inline-flex items-center gap-1"
            title="Copiar referência em formato ABNT"
          >
            <span>Citação ABNT</span>
            <span class="text-[11px]">📋</span>
          </button>

          <button
            type="button"
            onclick="window.print()"
            class="font-mono text-[10px] tracking-[0.1em] px-2.5 py-1 border border-black/15 dark:border-white/15 text-zinc-800 dark:text-[#ece4d6] hover:border-[#d6ad6e] hover:text-[#d6ad6e] transition-colors cursor-pointer bg-white/40 dark:bg-black/30 backdrop-blur-md"
          >
            Exportar PDF
          </button>
        </div>
      </div>

      <!-- Compact Editorial Hero Composition -->
      <div class="relative z-10 pointer-events-none max-w-7xl w-full mx-auto px-6 sm:px-10 pb-5 pt-3 grid grid-cols-1 lg:grid-cols-12 gap-5 items-end">
        <div class="lg:col-span-8 space-y-2">
          <h1 class="diorama-title font-serif font-light text-4xl sm:text-5xl lg:text-6xl leading-[0.92] tracking-[-0.03em] text-zinc-900 dark:text-[#f5ede0]">
            <span id="heroTitleMain">{meta.title_main}</span>
            <span id="heroTitleAccent" class="italic font-normal ml-2 text-[#b88940] dark:text-[#d6ad6e]">{meta.title_accent}</span>
          </h1>

          <p id="heroDescriptionText" class="font-serif text-sm sm:text-base text-zinc-600 dark:text-[#c7bdb0] max-w-xl leading-relaxed">
            {meta.description}
          </p>
        </div>

        <!-- Telemetry HUD & Carga Horária Acumulada (Melhoria 1) -->
        <div class="lg:col-span-4 flex flex-col items-start lg:items-end justify-end gap-2.5">
          <!-- Badge de Carga Horária Acumulada -->
          <div
            id="workloadBadge"
            class="pointer-events-auto inline-flex items-center gap-2 px-3 py-1 border border-[#d6ad6e]/40 bg-[#d6ad6e]/10 text-zinc-800 dark:text-[#f5ede0] backdrop-blur-md"
            title="Soma de horas comprovadas em cursos, pós-graduação e projetos"
          >
            <span class="font-mono text-xs text-[#b88940] dark:text-[#d6ad6e]">Σ</span>
            <span class="font-mono text-[11px] tracking-[0.08em]">
              <strong id="totalHoursVal" class="font-bold text-[#b88940] dark:text-[#d6ad6e]">{totalHours.toLocaleString("pt-BR")}h</strong> computadas
            </span>
          </div>

          <!-- Contadores das 3 Colunas Lattes -->
          <div class="pointer-events-auto grid grid-cols-3 border border-black/15 dark:border-white/15 bg-white/70 dark:bg-[#0e0c0a]/80 backdrop-blur-md divide-x divide-black/15 dark:divide-white/15">
            <button
              type="button"
              data-ring-focus="formacao"
              class="ring-trigger px-3 py-1.5 text-left hover:bg-[#d6ad6e]/10 transition-colors cursor-pointer group"
            >
              <span id="hudCountFormacao" class="block font-serif text-lg sm:text-xl font-light text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#d6ad6e] transition-colors tabular-nums">
                {String(formacoes.length).padStart(2, "0")}
              </span>
              <span class="font-mono text-[9px] tracking-[0.1em] text-zinc-500 dark:text-[#8f8577]">
                Formação
              </span>
            </button>

            <button
              type="button"
              data-ring-focus="evento"
              class="ring-trigger px-3 py-1.5 text-left hover:bg-[#d6ad6e]/10 transition-colors cursor-pointer group"
            >
              <span id="hudCountEvento" class="block font-serif text-lg sm:text-xl font-light text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#d6ad6e] transition-colors tabular-nums">
                {String(eventos.length).padStart(2, "0")}
              </span>
              <span class="font-mono text-[9px] tracking-[0.1em] text-zinc-500 dark:text-[#8f8577]">
                Eventos
              </span>
            </button>

            <button
              type="button"
              data-ring-focus="curso"
              class="ring-trigger px-3 py-1.5 text-left hover:bg-[#d6ad6e]/10 transition-colors cursor-pointer group"
            >
              <span id="hudCountCurso" class="block font-serif text-lg sm:text-xl font-light text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#d6ad6e] transition-colors tabular-nums">
                {String(cursos.length).padStart(2, "0")}
              </span>
              <span class="font-mono text-[9px] tracking-[0.1em] text-zinc-500 dark:text-[#8f8577]">
                Cursos
              </span>
            </button>
          </div>

          <div class="hidden sm:flex items-center gap-2 font-mono text-[9px] text-zinc-400 dark:text-[#7a7165]">
            <span>Esponja de Menger 3D</span>
            <span>·</span>
            <span>Mover ilumina</span>
            <span>·</span>
            <span>Arrastar gira</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================== -->
    <!-- BARRA DE FILTRO, BUSCA E TIMELINE DE ANOS (STICKY)    -->
    <!-- ===================================================== -->
    <div class="sticky top-[68px] z-20 border-b border-black/10 dark:border-white/10 bg-[#f7f5f0]/95 dark:bg-[#0b0a09]/95 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-6 sm:px-10 py-2.5 flex flex-col gap-2">
        <!-- Linha 1: Input de Busca Textual + Abas de Categoria -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-1 max-w-md flex items-center">
            <span class="font-mono text-[11px] text-[#b88940] dark:text-[#d6ad6e] mr-3 select-none">/</span>
            <input
              type="text"
              id="certSearchInput"
              placeholder="Filtrar por nome do evento, instituição ou tipo..."
              class="w-full bg-transparent border-0 border-b border-transparent focus:border-[#d6ad6e] py-1 text-xs sm:text-sm text-zinc-900 dark:text-[#ece4d6] placeholder-zinc-400 dark:placeholder-[#6e665b] focus:outline-none transition-colors font-sans"
            />
          </div>

          <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Filtrar categorias">
            <button
              type="button"
              id="filterBtnAll"
              data-cert-filter="all"
              class="cert-filter-btn font-mono text-[11px] px-3 py-1 border border-[#d6ad6e] bg-[#d6ad6e] text-[#090807] font-medium cursor-pointer transition-all"
            >
              Todos [{certificates.length}]
            </button>
            <button
              type="button"
              id="filterBtnFormacao"
              data-cert-filter="formacao"
              class="cert-filter-btn font-mono text-[11px] px-3 py-1 border border-transparent text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] hover:border-black/15 dark:hover:border-white/15 cursor-pointer transition-all"
            >
              I. Formação [{formacoes.length}]
            </button>
            <button
              type="button"
              id="filterBtnEvento"
              data-cert-filter="evento"
              class="cert-filter-btn font-mono text-[11px] px-3 py-1 border border-transparent text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] hover:border-black/15 dark:hover:border-white/15 cursor-pointer transition-all"
            >
              II. Eventos [{eventos.length}]
            </button>
            <button
              type="button"
              id="filterBtnCurso"
              data-cert-filter="curso"
              class="cert-filter-btn font-mono text-[11px] px-3 py-1 border border-transparent text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] hover:border-black/15 dark:hover:border-white/15 cursor-pointer transition-all"
            >
              III. Cursos [{cursos.length}]
            </button>
          </div>
        </div>

        <!-- Linha 2: Filtro por Ano / Linha do Tempo Rápida (Melhoria 2) -->
        <div class="flex items-center gap-2 overflow-x-auto py-1 scrollbar-none text-[10px] font-mono border-t border-black/5 dark:border-white/5">
          <span class="text-zinc-400 dark:text-[#7a7165] shrink-0">Ano / Período:</span>
          <button
            type="button"
            data-year-filter="all"
            class="year-filter-btn px-2 py-0.5 border border-[#d6ad6e] bg-[#d6ad6e]/20 text-[#b88940] dark:text-[#d6ad6e] font-semibold cursor-pointer shrink-0 transition-colors"
          >
            Todos
          </button>
          {
            availableYears.map((yr) => (
              <button
                type="button"
                data-year-filter={yr}
                class="year-filter-btn px-2 py-0.5 border border-transparent hover:border-black/15 dark:hover:border-white/15 text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] cursor-pointer shrink-0 transition-colors"
              >
                {yr}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- ===================================================== -->
    <!-- CORPO DO CURRÍCULO LATTES                             -->
    <!-- SEÇÃO I: FORMAÇÃO EM 1 COLUNA                         -->
    <!-- SEÇÕES II & III: EVENTOS | CURSOS EM 2 COLUNAS        -->
    <!-- ===================================================== -->
    <main class="max-w-7xl mx-auto px-6 sm:px-10 py-10 sm:py-14 space-y-14">
      <!-- =================================================== -->
      <!-- I. FORMAÇÃO ACADÊMICA (EM UMA COLUNA)               -->
      <!-- =================================================== -->
      <section
        id="section-formacao"
        data-section-category="formacao"
        class="cert-section"
      >
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4 border-b border-black/15 dark:border-white/15">
          <div class="space-y-0.5">
            <span class="font-mono text-[10px] tracking-[0.14em] text-[#b88940] dark:text-[#d6ad6e]">
              Seção I · Coluna Única
            </span>
            <h2 class="font-serif font-light text-2xl sm:text-3xl md:text-4xl tracking-[-0.02em] text-zinc-900 dark:text-[#f5ede0]">
              Formação Acadêmica <em class="font-normal text-[#b88940] dark:text-[#d6ad6e]">&amp; Titulação</em>
            </h2>
          </div>
          <p class="font-mono text-[10px] text-zinc-500 dark:text-[#8f8577]">
            Nome do Evento · Data do Evento · Tipo de Certificado · Link URL
          </p>
        </div>

        <div class="hidden md:grid md:grid-cols-12 gap-4 py-2.5 border-b border-black/10 dark:border-white/10 font-mono text-[10px] tracking-[0.12em] text-zinc-400 dark:text-[#7a7165]">
          <div class="col-span-2">Data do Evento</div>
          <div class="col-span-5">Nome da Formação / Evento</div>
          <div class="col-span-3">Tipo de Certificado</div>
          <div class="col-span-2 text-right">Link URL</div>
        </div>

        <div id="listFormacaoContainer" class="divide-y divide-black/10 dark:divide-white/10 border-b border-black/15 dark:border-white/15">
          {
            formacoes.length === 0 ? (
              <p class="py-10 text-sm text-zinc-500 font-serif italic">
                Nenhum registro de formação encontrado.
              </p>
            ) : (
              formacoes.map((item) => (
                <article
                  class="cert-card interactive-row group relative py-4 grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4 items-baseline transition-colors"
                  data-category="formacao"
                  data-name={item.name}
                  data-date={item.event_date}
                  data-type={item.certificate_type}
                  data-url={item.url || ""}
                  data-institution={item.institution || "Formação Acadêmica"}
                  data-workload={item.workload || ""}
                  data-search={`${item.name} ${item.event_date} ${item.certificate_type} ${item.institution || ""}`.toLowerCase()}
                >
                  <div class="md:col-span-2 font-mono text-xs text-[#b88940] dark:text-[#d6ad6e] tabular-nums">
                    {item.event_date}
                  </div>

                  <div class="md:col-span-5 space-y-0.5">
                    <h3 class="font-serif text-lg sm:text-xl font-normal text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#b88940] dark:group-hover:text-[#d6ad6e] transition-colors leading-snug">
                      {item.name}
                    </h3>
                    {(item.institution || item.workload) && (
                      <p class="font-sans text-xs text-zinc-500 dark:text-[#8f8577]">
                        {[item.institution, item.workload].filter(Boolean).join(" — ")}
                      </p>
                    )}
                  </div>

                  <div class="md:col-span-3">
                    <span class="inline-block font-mono text-[11px] px-2.5 py-0.5 border border-black/15 dark:border-white/15 text-zinc-700 dark:text-[#cfc5b6] bg-black/[0.02] dark:bg-white/[0.02]">
                      {item.certificate_type}
                    </span>
                  </div>

                  <div class="md:col-span-2 flex items-center md:justify-end gap-2 pt-1 md:pt-0">
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-[11px] px-3 py-1 border border-black/20 dark:border-white/20 text-zinc-900 dark:text-[#f5ede0] hover:border-[#d6ad6e] hover:bg-[#d6ad6e] hover:text-[#090807] transition-all"
                      >
                        Abrir URL ↗
                      </a>
                    ) : (
                      <span class="font-mono text-[11px] text-zinc-400">—</span>
                    )}
                  </div>
                </article>
              ))
            )
          }
        </div>
      </section>

      <!-- =================================================== -->
      <!-- II & III. DUAS COLUNAS LADO A LADO                  -->
      <!-- ESQUERDA: EVENTOS | DIREITA: CURSOS                 -->
      <!-- =================================================== -->
      <div
        id="twoColumnsContainer"
        class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-0 lg:divide-x lg:divide-black/15 dark:lg:divide-white/15 items-start"
      >
        <!-- COLUNA ESQUERDA: EVENTOS -->
        <section
          id="section-evento"
          data-section-category="evento"
          class="cert-section lg:pr-8"
        >
          <div class="flex items-end justify-between gap-4 pb-4 border-b border-black/15 dark:border-white/15">
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] tracking-[0.14em] text-[#b88940] dark:text-[#d6ad6e]">
                Seção II · Coluna Esquerda
              </span>
              <h2 class="font-serif font-light text-2xl sm:text-3xl tracking-[-0.02em] text-zinc-900 dark:text-[#f5ede0]">
                Eventos <em class="font-normal text-[#b88940] dark:text-[#d6ad6e]">&amp; Extensão</em>
              </h2>
            </div>
            <span id="secCountEvento" class="font-mono text-xs text-zinc-500 dark:text-[#8f8577] tabular-nums">
              [{String(eventos.length).padStart(2, "0")}]
            </span>
          </div>

          <div id="listEventoContainer" class="divide-y divide-black/10 dark:divide-white/10 border-b border-black/15 dark:border-white/15">
            {
              eventos.length === 0 ? (
                <p class="py-8 text-sm text-zinc-500 font-serif italic">
                  Nenhum evento registrado.
                </p>
              ) : (
                eventos.map((item) => (
                  <article
                    class="cert-card interactive-row group relative py-4 flex flex-col gap-2 transition-colors"
                    data-category="evento"
                    data-name={item.name}
                    data-date={item.event_date}
                    data-type={item.certificate_type}
                    data-url={item.url || ""}
                    data-institution={item.institution || "Participação em Evento"}
                    data-workload={item.workload || ""}
                    data-search={`${item.name} ${item.event_date} ${item.certificate_type} ${item.institution || ""}`.toLowerCase()}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="font-mono text-xs text-[#b88940] dark:text-[#d6ad6e] tabular-nums">
                        {item.event_date}
                      </span>
                      <span class="font-mono text-[10px] px-2 py-0.5 border border-black/15 dark:border-white/15 text-zinc-600 dark:text-[#cfc5b6]">
                        {item.certificate_type}
                      </span>
                    </div>

                    <div class="space-y-0.5">
                      <h3 class="font-serif text-lg sm:text-xl font-normal text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#b88940] dark:group-hover:text-[#d6ad6e] transition-colors leading-snug">
                        {item.name}
                      </h3>
                      {(item.institution || item.workload) && (
                        <p class="font-sans text-xs text-zinc-500 dark:text-[#8f8577]">
                          {[item.institution, item.workload].filter(Boolean).join(" — ")}
                        </p>
                      )}
                    </div>

                    <div class="pt-1 flex items-center justify-end">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[11px] px-3 py-1 border border-black/20 dark:border-white/20 text-zinc-900 dark:text-[#f5ede0] hover:border-[#d6ad6e] hover:bg-[#d6ad6e] hover:text-[#090807] transition-all"
                        >
                          Certificado URL ↗
                        </a>
                      ) : (
                        <span class="font-mono text-[11px] text-zinc-400">Sem link</span>
                      )}
                    </div>
                  </article>
                ))
              )
            }
          </div>
        </section>

        <!-- COLUNA DIREITA: CURSOS -->
        <section
          id="section-curso"
          data-section-category="curso"
          class="cert-section lg:pl-8"
        >
          <div class="flex items-end justify-between gap-4 pb-4 border-b border-black/15 dark:border-white/15">
            <div class="space-y-0.5">
              <span class="font-mono text-[10px] tracking-[0.14em] text-[#b88940] dark:text-[#d6ad6e]">
                Seção III · Coluna Direita
              </span>
              <h2 class="font-serif font-light text-2xl sm:text-3xl tracking-[-0.02em] text-zinc-900 dark:text-[#f5ede0]">
                Cursos <em class="font-normal text-[#b88940] dark:text-[#d6ad6e]">&amp; Certificações</em>
              </h2>
            </div>
            <span id="secCountCurso" class="font-mono text-xs text-zinc-500 dark:text-[#8f8577] tabular-nums">
              [{String(cursos.length).padStart(2, "0")}]
            </span>
          </div>

          <div id="listCursoContainer" class="divide-y divide-black/10 dark:divide-white/10 border-b border-black/15 dark:border-white/15">
            {
              cursos.length === 0 ? (
                <p class="py-8 text-sm text-zinc-500 font-serif italic">
                  Nenhum curso registrado.
                </p>
              ) : (
                cursos.map((item) => (
                  <article
                    class="cert-card interactive-row group relative py-4 flex flex-col gap-2 transition-colors"
                    data-category="curso"
                    data-name={item.name}
                    data-date={item.event_date}
                    data-type={item.certificate_type}
                    data-url={item.url || ""}
                    data-institution={item.institution || "Certificação Complementar"}
                    data-workload={item.workload || ""}
                    data-search={`${item.name} ${item.event_date} ${item.certificate_type} ${item.institution || ""}`.toLowerCase()}
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="font-mono text-xs text-[#b88940] dark:text-[#d6ad6e] tabular-nums">
                        {item.event_date}
                      </span>
                      <span class="font-mono text-[10px] px-2 py-0.5 border border-black/15 dark:border-white/15 text-zinc-600 dark:text-[#cfc5b6]">
                        {item.certificate_type}
                      </span>
                    </div>

                    <div class="space-y-0.5">
                      <h3 class="font-serif text-lg sm:text-xl font-normal text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#b88940] dark:group-hover:text-[#d6ad6e] transition-colors leading-snug">
                        {item.name}
                      </h3>
                      {(item.institution || item.workload) && (
                        <p class="font-sans text-xs text-zinc-500 dark:text-[#8f8577]">
                          {[item.institution, item.workload].filter(Boolean).join(" — ")}
                        </p>
                      )}
                    </div>

                    <div class="pt-1 flex items-center justify-end">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[11px] px-3 py-1 border border-black/20 dark:border-white/20 text-zinc-900 dark:text-[#f5ede0] hover:border-[#d6ad6e] hover:bg-[#d6ad6e] hover:text-[#090807] transition-all"
                        >
                          Certificado URL ↗
                        </a>
                      ) : (
                        <span class="font-mono text-[11px] text-zinc-400">Sem link</span>
                      )}
                    </div>
                  </article>
                ))
              )
            }
          </div>
        </section>
      </div>
    </main>
  </div>

  <Contact />
</Layout>

<style>
  .diorama-archive {
    --serif: "Cormorant Garamond", Georgia, serif;
    --sans: "Instrument Sans", system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    font-family: var(--sans);
  }

  .font-serif {
    font-family: var(--serif);
  }

  .font-mono {
    font-family: var(--mono);
  }

  .font-sans {
    font-family: var(--sans);
  }

  .diorama-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .interactive-row {
    background-image: radial-gradient(
      380px circle at var(--row-mx, 50%) var(--row-my, 50%),
      rgba(214, 173, 110, 0.08),
      transparent 70%
    );
  }

  @media print {
    #dioramaStage canvas,
    .cert-filter-btn,
    .year-filter-btn {
      display: none !important;
    }
  }
</style>

<script>
  import * as THREE from "https://esm.sh/three@0.170.0";
  import { getCertificatesStore, calculateTotalHours } from "../lib/certificates";
  import type { CertificateItem } from "../lib/supabase";

  document.addEventListener("DOMContentLoaded", () => {
    const rootEl = document.getElementById("certPageRoot");
    const profileName = rootEl?.getAttribute("data-profile-name") || "Bernardo Nogueira";
    const searchInput = document.getElementById("certSearchInput") as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll(".cert-filter-btn");
    const sections = document.querySelectorAll(".cert-section");
    const twoColumnsContainer = document.getElementById("twoColumnsContainer");
    const copyAbntBtn = document.getElementById("copyAbntBtn");
    const abntToast = document.getElementById("abntToast");
    const abntToastText = document.getElementById("abntToastText");

    let activeCategory = "all";
    let activeYear = "all";
    let query = "";

    // Target state for the Menger Sponge 3D Fractal
    const sceneTarget = {
      category: "all" as "all" | "formacao" | "evento" | "curso",
      pulse: 0,
      explode: 0,
    };

    function showToast(msg: string) {
      if (!abntToast || !abntToastText) return;
      abntToastText.textContent = msg;
      abntToast.classList.remove("hidden");
      setTimeout(() => abntToast.classList.add("hidden"), 3200);
    }

    // Copiar Citação em Formato ABNT (Melhoria 3)
    copyAbntBtn?.addEventListener("click", async () => {
      const now = new Date();
      const meses = ["jan.", "fev.", "mar.", "abr.", "mai.", "jun.", "jul.", "ago.", "set.", "out.", "nov.", "dez."];
      const dataStr = `${now.getDate()} ${meses[now.getMonth()]} ${now.getFullYear()}`;
      const url = window.location.href;

      const sobrenome = profileName.split(" ").slice(-1)[0].toUpperCase();
      const prenomes = profileName.split(" ").slice(0, -1).join(" ");
      const citacao = `${sobrenome}, ${prenomes}. Acervo de Certificados e Formação Acadêmica (Plataforma Lattes). ${now.getFullYear()}. Disponível em: <${url}>. Acesso em: ${dataStr}.`;

      try {
        await navigator.clipboard.writeText(citacao);
        showToast("Citação ABNT copiada para a área de transferência!");
      } catch (e) {
        showToast("Erro ao copiar citação ABNT.");
      }
    });

    function escapeAttr(str: string) {
      return (str || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function renderFormacaoRow(item: CertificateItem) {
      const searchStr = `${item.name} ${item.event_date} ${item.certificate_type} ${item.institution || ""}`.toLowerCase();
      const metaText = [item.institution, item.workload].filter(Boolean).join(" — ");
      return `
        <article
          class="cert-card interactive-row group relative py-4 grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4 items-baseline transition-colors"
          data-category="formacao"
          data-name="${escapeAttr(item.name)}"
          data-date="${escapeAttr(item.event_date)}"
          data-type="${escapeAttr(item.certificate_type)}"
          data-url="${escapeAttr(item.url || "")}"
          data-institution="${escapeAttr(item.institution || "Formação Acadêmica")}"
          data-workload="${escapeAttr(item.workload || "")}"
          data-search="${escapeAttr(searchStr)}"
        >
          <div class="md:col-span-2 font-mono text-xs text-[#b88940] dark:text-[#d6ad6e] tabular-nums">
            ${escapeAttr(item.event_date)}
          </div>
          <div class="md:col-span-5 space-y-0.5">
            <h3 class="font-serif text-lg sm:text-xl font-normal text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#b88940] dark:group-hover:text-[#d6ad6e] transition-colors leading-snug">
              ${escapeAttr(item.name)}
            </h3>
            ${metaText ? `<p class="font-sans text-xs text-zinc-500 dark:text-[#8f8577]">${escapeAttr(metaText)}</p>` : ""}
          </div>
          <div class="md:col-span-3">
            <span class="inline-block font-mono text-[11px] px-2.5 py-0.5 border border-black/15 dark:border-white/15 text-zinc-700 dark:text-[#cfc5b6] bg-black/[0.02] dark:bg-white/[0.02]">
              ${escapeAttr(item.certificate_type)}
            </span>
          </div>
          <div class="md:col-span-2 flex items-center md:justify-end gap-2 pt-1 md:pt-0">
            ${
              item.url
                ? `<a href="${escapeAttr(item.url)}" target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] px-3 py-1 border border-black/20 dark:border-white/20 text-zinc-900 dark:text-[#f5ede0] hover:border-[#d6ad6e] hover:bg-[#d6ad6e] hover:text-[#090807] transition-all">Abrir URL ↗</a>`
                : `<span class="font-mono text-[11px] text-zinc-400">—</span>`
            }
          </div>
        </article>
      `;
    }

    function renderColumnRow(item: CertificateItem, cat: "evento" | "curso") {
      const searchStr = `${item.name} ${item.event_date} ${item.certificate_type} ${item.institution || ""}`.toLowerCase();
      const metaText = [item.institution, item.workload].filter(Boolean).join(" — ");
      const defaultInst = cat === "evento" ? "Participação em Evento" : "Certificação Complementar";
      return `
        <article
          class="cert-card interactive-row group relative py-4 flex flex-col gap-2 transition-colors"
          data-category="${cat}"
          data-name="${escapeAttr(item.name)}"
          data-date="${escapeAttr(item.event_date)}"
          data-type="${escapeAttr(item.certificate_type)}"
          data-url="${escapeAttr(item.url || "")}"
          data-institution="${escapeAttr(item.institution || defaultInst)}"
          data-workload="${escapeAttr(item.workload || "")}"
          data-search="${escapeAttr(searchStr)}"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-xs text-[#b88940] dark:text-[#d6ad6e] tabular-nums">
              ${escapeAttr(item.event_date)}
            </span>
            <span class="font-mono text-[10px] px-2 py-0.5 border border-black/15 dark:border-white/15 text-zinc-600 dark:text-[#cfc5b6]">
              ${escapeAttr(item.certificate_type)}
            </span>
          </div>
          <div class="space-y-0.5">
            <h3 class="font-serif text-lg sm:text-xl font-normal text-zinc-900 dark:text-[#f5ede0] group-hover:text-[#b88940] dark:group-hover:text-[#d6ad6e] transition-colors leading-snug">
              ${escapeAttr(item.name)}
            </h3>
            ${metaText ? `<p class="font-sans text-xs text-zinc-500 dark:text-[#8f8577]">${escapeAttr(metaText)}</p>` : ""}
          </div>
          <div class="pt-1 flex items-center justify-end">
            ${
              item.url
                ? `<a href="${escapeAttr(item.url)}" target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] px-3 py-1 border border-black/20 dark:border-white/20 text-zinc-900 dark:text-[#f5ede0] hover:border-[#d6ad6e] hover:bg-[#d6ad6e] hover:text-[#090807] transition-all">Certificado URL ↗</a>`
                : `<span class="font-mono text-[11px] text-zinc-400">Sem link</span>`
            }
          </div>
        </article>
      `;
    }

    function bindRowInteractions() {
      document.querySelectorAll(".interactive-row").forEach((row) => {
        row.addEventListener("pointermove", (e: Event) => {
          const pe = e as PointerEvent;
          const rect = (row as HTMLElement).getBoundingClientRect();
          (row as HTMLElement).style.setProperty("--row-mx", `${pe.clientX - rect.left}px`);
          (row as HTMLElement).style.setProperty("--row-my", `${pe.clientY - rect.top}px`);
        });

        row.addEventListener("pointerenter", () => {
          const cat = row.getAttribute("data-category") as any;
          if (cat) {
            sceneTarget.category = cat;
            sceneTarget.pulse = 0.7;
          }
        });
      });
    }

    // Dynamic Live Sync from Supabase (/admin)
    async function syncLiveFromAdmin() {
      try {
        const { items, meta, fromDatabase } = await getCertificatesStore();
        if (!fromDatabase) return;

        const heroTitleMain = document.getElementById("heroTitleMain");
        const heroTitleAccent = document.getElementById("heroTitleAccent");
        const heroDesc = document.getElementById("heroDescriptionText");
        const heroLattes = document.getElementById("heroLattesLink") as HTMLAnchorElement | null;
        const totalHoursEl = document.getElementById("totalHoursVal");

        if (heroTitleMain) heroTitleMain.textContent = meta.title_main;
        if (heroTitleAccent) heroTitleAccent.textContent = meta.title_accent;
        if (heroDesc) heroDesc.textContent = meta.description;
        if (heroLattes && meta.lattes_url) heroLattes.href = meta.lattes_url;

        // Atualiza horas acumuladas
        const hours = calculateTotalHours(items);
        if (totalHoursEl) totalHoursEl.textContent = `${hours.toLocaleString("pt-BR")}h`;

        const fList = items.filter((c) => c.category === "formacao");
        const eList = items.filter((c) => c.category === "evento");
        const cList = items.filter((c) => c.category === "curso");

        const hudF = document.getElementById("hudCountFormacao");
        const hudE = document.getElementById("hudCountEvento");
        const hudC = document.getElementById("hudCountCurso");
        const secE = document.getElementById("secCountEvento");
        const secC = document.getElementById("secCountCurso");

        if (hudF) hudF.textContent = String(fList.length).padStart(2, "0");
        if (hudE) hudE.textContent = String(eList.length).padStart(2, "0");
        if (hudC) hudC.textContent = String(cList.length).padStart(2, "0");
        if (secE) secE.textContent = `[${String(eList.length).padStart(2, "0")}]`;
        if (secC) secC.textContent = `[${String(cList.length).padStart(2, "0")}]`;

        const btnAll = document.getElementById("filterBtnAll");
        const btnF = document.getElementById("filterBtnFormacao");
        const btnE = document.getElementById("filterBtnEvento");
        const btnC = document.getElementById("filterBtnCurso");

        if (btnAll) btnAll.textContent = `Todos [${items.length}]`;
        if (btnF) btnF.textContent = `I. Formação [${fList.length}]`;
        if (btnE) btnE.textContent = `II. Eventos [${eList.length}]`;
        if (btnC) btnC.textContent = `III. Cursos [${cList.length}]`;

        const listF = document.getElementById("listFormacaoContainer");
        const listE = document.getElementById("listEventoContainer");
        const listC = document.getElementById("listCursoContainer");

        if (listF) {
          listF.innerHTML = fList.length
            ? fList.map(renderFormacaoRow).join("")
            : `<p class="py-10 text-sm text-zinc-500 font-serif italic">Nenhum registro de formação encontrado.</p>`;
        }
        if (listE) {
          listE.innerHTML = eList.length
            ? eList.map((i) => renderColumnRow(i, "evento")).join("")
            : `<p class="py-8 text-sm text-zinc-500 font-serif italic">Nenhum evento registrado.</p>`;
        }
        if (listC) {
          listC.innerHTML = cList.length
            ? cList.map((i) => renderColumnRow(i, "curso")).join("")
            : `<p class="py-8 text-sm text-zinc-500 font-serif italic">Nenhum curso registrado.</p>`;
        }

        bindRowInteractions();
        applyFilters();
      } catch (err) {
        console.error("Erro ao sincronizar certificados:", err);
      }
    }

    function setCategoryFocus(category: string, scrollIntoView = false) {
      activeCategory = category;
      sceneTarget.category = category as any;
      sceneTarget.pulse = 1;
      sceneTarget.explode = category === "all" ? 0 : 0.24;

      filterButtons.forEach((b) => {
        const isCurrent = (b.getAttribute("data-cert-filter") || "all") === category;
        if (isCurrent) {
          b.className =
            "cert-filter-btn font-mono text-[11px] px-3 py-1 border border-[#d6ad6e] bg-[#d6ad6e] text-[#090807] font-medium cursor-pointer transition-all";
        } else {
          b.className =
            "cert-filter-btn font-mono text-[11px] px-3 py-1 border border-transparent text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] hover:border-black/15 dark:hover:border-white/15 cursor-pointer transition-all";
        }
      });

      applyFilters();

      if (scrollIntoView && category !== "all") {
        const targetEl = document.getElementById(`section-${category}`);
        targetEl?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function applyFilters() {
      sections.forEach((section) => {
        const sectionCategory = section.getAttribute("data-section-category");
        const matchesCategory = activeCategory === "all" || activeCategory === sectionCategory;

        if (!matchesCategory) {
          section.classList.add("hidden");
          return;
        }

        section.classList.remove("hidden");

        const cards = section.querySelectorAll(".cert-card");
        cards.forEach((card) => {
          const text = card.getAttribute("data-search") || "";
          const dateStr = card.getAttribute("data-date") || "";
          const matchesQuery = !query || text.includes(query);
          const matchesYear = activeYear === "all" || dateStr.includes(activeYear);

          if (matchesQuery && matchesYear) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });

      if (twoColumnsContainer) {
        if (activeCategory === "evento" || activeCategory === "curso") {
          twoColumnsContainer.classList.remove("lg:grid-cols-2", "lg:divide-x");
          twoColumnsContainer.classList.add("lg:grid-cols-1");
        } else {
          twoColumnsContainer.classList.remove("lg:grid-cols-1");
          twoColumnsContainer.classList.add("lg:grid-cols-2", "lg:divide-x");
        }
      }
    }

    searchInput?.addEventListener("input", (e) => {
      query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-cert-filter") || "all";
        setCategoryFocus(cat, false);
      });
    });

    // Filtro por Ano / Timeline Rápida (Melhoria 2)
    document.querySelectorAll(".year-filter-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeYear = btn.getAttribute("data-year-filter") || "all";

        document.querySelectorAll(".year-filter-btn").forEach((b) => {
          const isCurrent = b === btn;
          if (isCurrent) {
            b.className =
              "year-filter-btn px-2 py-0.5 border border-[#d6ad6e] bg-[#d6ad6e]/20 text-[#b88940] dark:text-[#d6ad6e] font-semibold cursor-pointer shrink-0 transition-colors";
          } else {
            b.className =
              "year-filter-btn px-2 py-0.5 border border-transparent hover:border-black/15 dark:hover:border-white/15 text-zinc-600 dark:text-[#8f8577] hover:text-zinc-900 dark:hover:text-[#ece4d6] cursor-pointer shrink-0 transition-colors";
          }
        });

        applyFilters();
      });
    });

    document.querySelectorAll(".ring-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-ring-focus") || "all";
        setCategoryFocus(cat, true);
      });
    });

    bindRowInteractions();
    syncLiveFromAdmin();

    // =========================================================
    // 3. FRACTAL DE ESPONJA DE MENGER 3D (THREE.JS COMPACTO)
    // =========================================================
    const canvas = document.getElementById("dioramaCanvas") as HTMLCanvasElement | null;
    const stage = document.getElementById("dioramaStage");
    if (!canvas || !stage) return;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(-0.55, 0.15, 5.8);

    const spongeGroup = new THREE.Group();
    spongeGroup.position.set(1.75, 0.02, 0);
    scene.add(spongeGroup);

    // Gerar coordenadas da Esponja de Menger (Nível 2)
    interface VoxelData {
      bx: number;
      by: number;
      bz: number;
      mx: number;
      my: number;
      mz: number;
      shell: "formacao" | "evento" | "curso";
    }

    const voxels: VoxelData[] = [];
    const totalSize = 1.95;
    const step = totalSize / 9;

    for (let x = 0; x < 9; x++) {
      for (let y = 0; y < 9; y++) {
        for (let z = 0; z < 9; z++) {
          // Checagem Nível 1 (macro 3x3x3)
          const x1 = Math.floor(x / 3);
          const y1 = Math.floor(y / 3);
          const z1 = Math.floor(z / 3);
          const zeros1 = (x1 === 1 ? 1 : 0) + (y1 === 1 ? 1 : 0) + (z1 === 1 ? 1 : 0);
          if (zeros1 >= 2) continue;

          // Checagem Nível 2 (micro 3x3x3)
          const x2 = x % 3;
          const y2 = y % 3;
          const z2 = z % 3;
          const zeros2 = (x2 === 1 ? 1 : 0) + (y2 === 1 ? 1 : 0) + (z2 === 1 ? 1 : 0);
          if (zeros2 >= 2) continue;

          const bx = (x - 4) * step;
          const by = (y - 4) * step;
          const bz = (z - 4) * step;

          // Direção macro normal (-1, 0, 1) para expansão fractal
          const mx = x1 - 1;
          const my = y1 - 1;
          const mz = z1 - 1;

          // Classificar concha para ressonar com as colunas do Lattes
          const maxCoord = Math.max(Math.abs(x - 4), Math.abs(y - 4), Math.abs(z - 4));
          const shell: "formacao" | "evento" | "curso" =
            maxCoord === 4 ? "formacao" : maxCoord === 3 ? "evento" : "curso";

          voxels.push({ bx, by, bz, mx, my, mz, shell });
        }
      }
    }

    const boxGeo = new THREE.BoxGeometry(step * 0.91, step * 0.91, step * 0.91);
    const spongeMat = new THREE.MeshStandardMaterial({
      color: new THREE.Color("#ffffff"),
      metalness: 0.82,
      roughness: 0.24,
    });

    const instancedSponge = new THREE.InstancedMesh(boxGeo, spongeMat, voxels.length);
    spongeGroup.add(instancedSponge);

    // Moldura Arquitetônica Externa da Esponja
    const cageGeo = new THREE.EdgesGeometry(new THREE.BoxGeometry(totalSize * 1.03, totalSize * 1.03, totalSize * 1.03));
    const cageMat = new THREE.LineBasicMaterial({
      color: new THREE.Color("#d6ad6e"),
      transparent: true,
      opacity: 0.32,
    });
    const cageLines = new THREE.LineSegments(cageGeo, cageMat);
    spongeGroup.add(cageLines);

    // Partículas sutis
    const particlesCount = 80;
    const posArray = new Float32Array(particlesCount * 3);
    for (let i = 0; i < particlesCount * 3; i += 3) {
      posArray[i] = (Math.random() - 0.5) * 8.5;
      posArray[i + 1] = (Math.random() - 0.5) * 4.2;
      posArray[i + 2] = (Math.random() - 0.5) * 4.8;
    }
    const particlesGeo = new THREE.BufferGeometry();
    particlesGeo.setAttribute("position", new THREE.BufferAttribute(posArray, 3));
    const particlesMat = new THREE.PointsMaterial({
      size: 0.024,
      color: new THREE.Color("#d6ad6e"),
      transparent: true,
      opacity: 0.4,
    });
    const particlesMesh = new THREE.Points(particlesGeo, particlesMat);
    scene.add(particlesMesh);

    // Iluminação do Studio (Key Lantern + Rim + Fill)
    const ambientLight = new THREE.AmbientLight("#ffffff", 0.5);
    scene.add(ambientLight);

    const lanternLight = new THREE.PointLight("#ffcf87", 11, 14, 1.4);
    lanternLight.position.set(2.2, 1.2, 3.2);
    scene.add(lanternLight);

    const rimLight = new THREE.DirectionalLight("#7c9cb8", 2.4);
    rimLight.position.set(-4, -3, -2);
    scene.add(rimLight);

    const topLight = new THREE.DirectionalLight("#ffd9a0", 2.0);
    topLight.position.set(1, 5, 3);
    scene.add(topLight);

    const dummy = new THREE.Object3D();
    const colorHelper = new THREE.Color();

    function updateInstanceColors(activeCat: string) {
      const isDark = document.documentElement.classList.contains("dark");
      const baseGold = isDark ? "#d6ad6e" : "#c49346";
      const baseCopper = isDark ? "#b87356" : "#a85f42";
      const baseObsidian = isDark ? "#2a2520" : "#cfc7b8";
      const dimTone = isDark ? "#181512" : "#e2ddd2";

      for (let i = 0; i < voxels.length; i++) {
        const v = voxels[i];
        if (activeCat === "all") {
          if (v.shell === "formacao") colorHelper.set(baseGold);
          else if (v.shell === "evento") colorHelper.set(baseCopper);
          else colorHelper.set(baseObsidian);
        } else {
          if (v.shell === activeCat) colorHelper.set("#e5be7e");
          else colorHelper.set(dimTone);
        }
        instancedSponge.setColorAt(i, colorHelper);
      }
      if (instancedSponge.instanceColor) instancedSponge.instanceColor.needsUpdate = true;
    }

    function updateInstanceMatrices(expansion: number) {
      for (let i = 0; i < voxels.length; i++) {
        const v = voxels[i];
        dummy.position.set(
          v.bx + v.mx * expansion,
          v.by + v.my * expansion,
          v.bz + v.mz * expansion
        );
        dummy.updateMatrix();
        instancedSponge.setMatrixAt(i, dummy.matrix);
      }
      instancedSponge.instanceMatrix.needsUpdate = true;
    }

    function syncThemeColors() {
      const isDark = document.documentElement.classList.contains("dark");
      ambientLight.intensity = isDark ? 0.42 : 1.15;
      lanternLight.intensity = isDark ? 11.5 : 7.5;
      updateInstanceColors(sceneTarget.category);
    }

    updateInstanceMatrices(0);
    syncThemeColors();

    const themeObserver = new MutationObserver(syncThemeColors);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    function resize() {
      if (!stage) return;
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      spongeGroup.position.x = w < 1024 ? 0 : 1.75;
      camera.position.x = w < 1024 ? 0 : -0.55;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener("resize", resize);

    // Pointer & Drag Choreography
    const pointer = { x: 0.2, y: 0.1, sx: 0.2, sy: 0.1, down: false, dragX: 0.32, dragY: 0.55 };
    stage.addEventListener("pointermove", (e: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      const nx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      const ny = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      if (pointer.down) {
        pointer.dragY += (nx - pointer.x) * 1.8;
        pointer.dragX -= (ny - pointer.y) * 1.8;
      }
      pointer.x = nx;
      pointer.y = ny;
    });

    stage.addEventListener("pointerdown", () => {
      pointer.down = true;
      sceneTarget.pulse = 1;
      sceneTarget.explode = sceneTarget.explode > 0.1 ? 0 : 0.26;
    });
    window.addEventListener("pointerup", () => {
      pointer.down = false;
    });

    let currentExplode = 0;
    let lastCategory = sceneTarget.category;
    let lastTime = performance.now();

    function animate(now: number) {
      requestAnimationFrame(animate);
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;
      const t = now * 0.001;

      const damp = 1 - Math.exp(-6 * dt);
      pointer.sx += (pointer.x - pointer.sx) * damp;
      pointer.sy += (pointer.y - pointer.sy) * damp;
      sceneTarget.pulse = Math.max(0, sceneTarget.pulse - dt * 2.0);

      if (lastCategory !== sceneTarget.category) {
        lastCategory = sceneTarget.category;
        updateInstanceColors(lastCategory);
      }

      // Expansão dos blocos da Esponja de Menger
      const targetExp = sceneTarget.explode + sceneTarget.pulse * 0.12 + Math.sin(t * 1.2) * 0.015;
      if (Math.abs(targetExp - currentExplode) > 0.0005) {
        currentExplode += (targetExp - currentExplode) * damp;
        updateInstanceMatrices(Math.max(0, currentExplode));
        const cageScale = 1 + Math.max(0, currentExplode) * 0.85;
        cageLines.scale.setScalar(cageScale);
      }

      // Lanterna acompanha o cursor
      lanternLight.position.x = spongeGroup.position.x + pointer.sx * 3.0;
      lanternLight.position.y = pointer.sy * 2.0 + 0.4;
      lanternLight.position.z = 3.1;

      const scrollY = window.scrollY * 0.0009;
      spongeGroup.rotation.y = t * 0.18 + pointer.dragY + pointer.sx * 0.35 + scrollY;
      spongeGroup.rotation.x = pointer.dragX - pointer.sy * 0.25 + Math.sin(t * 0.4) * 0.08;

      particlesMesh.rotation.y = t * 0.025 + pointer.sx * 0.06;

      renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);
  });
</script>
