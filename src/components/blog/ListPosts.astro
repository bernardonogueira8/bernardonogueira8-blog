---
import BlogPost from "./BlogPost.astro";
import Heading from "../ui/Heading.astro";
import { getAllPosts, getAllTags } from "../../lib/posts";

// Prop to determine whether to exclude the latest post or a specific post
export interface Props {
  excludeLatest?: boolean;
  currentPostUrl?: string;
  all?: boolean;
  showSearch?: boolean;
}

const {
  excludeLatest = false,
  currentPostUrl = "",
  all = false,
  showSearch = !currentPostUrl,
} = Astro.props as Props;

const allPosts = await getAllPosts();
const allTags = showSearch ? await getAllTags() : [];
const suggestedTags = allTags.slice(0, 5);

// Filter posts according to props
let postsToShow = allPosts;

if (currentPostUrl) {
  // Exclude current post if its URL is provided
  postsToShow = postsToShow.filter((post) => {
    const postUrl = `/blog/posts/${post.slug}`;
    const normalizedPostUrl = postUrl.replace(/\/$/, "");
    const normalizedCurrentUrl = currentPostUrl.replace(/\/$/, "");
    return normalizedPostUrl !== normalizedCurrentUrl && !normalizedCurrentUrl.endsWith(post.slug);
  });
} else if (excludeLatest) {
  // If no specific URL but want to exclude the latest
  postsToShow = postsToShow.slice(1);
}

// If showSearch is false and not all, limit to 4 posts
const initialLimit = !all && !showSearch;
const postsToRender = initialLimit ? postsToShow.slice(0, 4) : postsToShow;
---

<section
  class="py-8 max-lg:px-4 max-md:px-8 max-sm:px-0 max-md:py-4 max-w-4xl mx-auto"
>
  {
    all && (
      <div class="flex gap-4 pb-6 items-center text-center justify-center">
        <Heading text="Todos os" textGradient="Posts" level={2} />
      </div>
    )
  }

  {
    showSearch && (
      <div class="w-full mb-10">
        <div class="relative flex items-center group">
          <div class="absolute left-4.5 flex items-center justify-center pointer-events-none text-zinc-400 dark:text-zinc-500 group-focus-within:text-sunset-500 dark:group-focus-within:text-sunset-400 transition-colors">
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>

          <input
            type="search"
            id="blogSearchInput"
            autocomplete="off"
            placeholder="Pesquisar artigos por título, assunto, tecnologia ou tag..."
            class="w-full pl-12 pr-24 py-3.5 sm:py-4 rounded-2xl bg-white/90 dark:bg-zinc-900/85 border border-zinc-200/90 dark:border-white/10 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 text-sm sm:text-base font-medium shadow-xs backdrop-blur-md transition-all duration-200 focus:outline-none focus:border-sunset-500 dark:focus:border-sunset-400 focus:ring-4 focus:ring-sunset-500/15 hover:border-zinc-300 dark:hover:border-white/20"
            aria-label="Pesquisar artigos do blog"
          />

          <div class="absolute right-3.5 flex items-center gap-2">
            <button
              type="button"
              id="clearSearchBtn"
              aria-label="Limpar pesquisa"
              class="hidden size-7 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-sunset-500 hover:text-white dark:hover:bg-sunset-500 dark:hover:text-white items-center justify-center text-xs transition-all cursor-pointer"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>

            <kbd class="hidden sm:inline-flex items-center px-2 py-1 text-[11px] font-mono font-medium text-zinc-400 dark:text-zinc-500 bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 rounded-lg pointer-events-none select-none">
              ⌘K
            </kbd>
          </div>
        </div>

        {suggestedTags.length > 0 && (
          <div class="flex items-center gap-1.5 sm:gap-2 mt-3 flex-wrap px-1">
            <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">
              Sugestões:
            </span>
            {suggestedTags.map((t) => (
              <button
                type="button"
                class="search-suggest-chip text-xs font-medium px-2.5 py-0.5 rounded-lg bg-zinc-100/80 hover:bg-sunset-50 dark:bg-zinc-800/80 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-sunset-600 dark:hover:text-sunset-400 border border-zinc-200/60 dark:border-white/5 transition-colors cursor-pointer"
                data-term={t}
              >
                #{t}
              </button>
            ))}
          </div>
        )}

        <div
          id="searchStatusBar"
          class="hidden items-center justify-between mt-3 px-1 text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400"
        >
          <span id="searchResultText" />
          <button
            type="button"
            id="searchResetTextBtn"
            class="text-sunset-500 hover:text-sunset-600 dark:hover:text-sunset-400 hover:underline cursor-pointer"
          >
            Limpar filtro
          </button>
        </div>
      </div>
    )
  }

  <div id="postsListContainer" class="flex flex-col gap-8 w-full mx-auto">
    {
      postsToRender.map((post, index) => {
        const isInitiallyHidden = showSearch && !all && index >= 4;
        return (
          <div
            class:list={[
              "post-item transition-all duration-300",
              isInitiallyHidden && "hidden post-overflow-initial",
            ]}
            data-title={post.title}
            data-description={post.description || ""}
            data-tags={(post.tags || []).join(" ")}
            data-languages={(post.languages || []).join(" ")}
          >
            <BlogPost
              url={`/blog/posts/${post.slug}`}
              title={post.title}
              date={post.pub_date}
              tags={post.tags}
              languages={post.languages}
              image={
                post.image_url
                  ? { url: post.image_url, alt: post.image_alt || post.title }
                  : undefined
              }
              mediumUrl={post.medium_url}
            />
          </div>
        );
      })
    }
  </div>

  {
    showSearch && (
      <div
        id="noResultsState"
        class="hidden flex-col items-center justify-center py-16 px-4 text-center rounded-3xl border border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 my-6"
      >
        <div class="size-16 rounded-2xl bg-sunset-500/10 dark:bg-fire-500/15 flex items-center justify-center text-sunset-500 dark:text-sunset-400 mb-4 border border-sunset-500/20 shadow-xs">
          <svg
            class="size-8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white mb-2">
          Nenhum artigo encontrado
        </h3>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-md mb-5 leading-relaxed">
          Não encontramos nenhum artigo correspondente a "
          <span
            class="font-semibold text-sunset-600 dark:text-sunset-400"
            id="searchedQuerySpan"
          />
          ". Tente buscar por outros termos ou explore as sugestões acima.
        </p>
        <button
          type="button"
          id="emptyStateResetBtn"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-linear-to-r from-fire-500 to-sunset-500 hover:from-fire-600 hover:to-sunset-600 text-white shadow-sm transition-all hover:scale-105 active:scale-95 cursor-pointer"
        >
          Limpar pesquisa
        </button>
      </div>
    )
  }

  {
    !all && (
      <div id="morePosts" class="w-full flex justify-center text-center my-12">
        <a
          href="/blog/posts/"
          class="font-bold cursor-pointer text-mint-400 dark:text-mint-100 hover:text-mint-500 dark:hover:text-mint-300 transition-all"
        >
          Ver todas as postagens...
        </a>
      </div>
    )
  }
</section>

{
  showSearch && (
    <script>
      function initBlogSearch() {
        const input = document.getElementById("blogSearchInput") as HTMLInputElement | null;
        if (!input || input.dataset.searchInitialized === "true") return;
        input.dataset.searchInitialized = "true";

        const clearBtn = document.getElementById("clearSearchBtn");
        const statusBar = document.getElementById("searchStatusBar");
        const resultText = document.getElementById("searchResultText");
        const resetTextBtn = document.getElementById("searchResetTextBtn");
        const emptyState = document.getElementById("noResultsState");
        const emptyStateResetBtn = document.getElementById("emptyStateResetBtn");
        const searchedQuerySpan = document.getElementById("searchedQuerySpan");
        const morePosts = document.getElementById("morePosts");
        const postItems = Array.from(document.querySelectorAll<HTMLElement>(".post-item"));
        const suggestChips = Array.from(document.querySelectorAll<HTMLElement>(".search-suggest-chip"));

        if (postItems.length === 0) return;

        const normalize = (str: string | null) =>
          (str || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .trim();

        const performSearch = (rawQuery: string) => {
          const q = normalize(rawQuery);

          if (!q) {
            clearBtn?.classList.add("hidden");
            clearBtn?.classList.remove("flex");
            statusBar?.classList.add("hidden");
            statusBar?.classList.remove("flex");
            emptyState?.classList.add("hidden");
            emptyState?.classList.remove("flex");

            postItems.forEach((item) => {
              if (item.classList.contains("post-overflow-initial")) {
                item.classList.add("hidden");
              } else {
                item.classList.remove("hidden");
              }
            });

            if (morePosts) morePosts.classList.remove("hidden");
            return;
          }

          clearBtn?.classList.remove("hidden");
          clearBtn?.classList.add("flex");
          if (morePosts) morePosts.classList.add("hidden");

          let matches = 0;
          postItems.forEach((item) => {
            const title = normalize(item.getAttribute("data-title"));
            const desc = normalize(item.getAttribute("data-description"));
            const tags = normalize(item.getAttribute("data-tags"));
            const langs = normalize(item.getAttribute("data-languages"));

            const isMatch =
              title.includes(q) ||
              desc.includes(q) ||
              tags.includes(q) ||
              langs.includes(q);

            if (isMatch) {
              item.classList.remove("hidden");
              matches++;
            } else {
              item.classList.add("hidden");
            }
          });

          if (statusBar && resultText) {
            statusBar.classList.remove("hidden");
            statusBar.classList.add("flex");
            resultText.textContent =
              matches === 1
                ? `1 artigo encontrado para "${rawQuery}"`
                : `${matches} artigos encontrados para "${rawQuery}"`;
          }

          if (emptyState) {
            if (matches === 0) {
              emptyState.classList.remove("hidden");
              emptyState.classList.add("flex");
              if (searchedQuerySpan) searchedQuerySpan.textContent = rawQuery;
            } else {
              emptyState.classList.add("hidden");
              emptyState.classList.remove("flex");
            }
          }
        };

        input.addEventListener("input", (e) => {
          const target = e.target as HTMLInputElement;
          performSearch(target.value);
        });

        const resetSearch = () => {
          input.value = "";
          performSearch("");
          input.focus();
        };

        clearBtn?.addEventListener("click", resetSearch);
        resetTextBtn?.addEventListener("click", resetSearch);
        emptyStateResetBtn?.addEventListener("click", resetSearch);

        suggestChips.forEach((chip) => {
          chip.addEventListener("click", () => {
            const term = chip.getAttribute("data-term") || "";
            input.value = term;
            performSearch(term);
            input.focus();
          });
        });

        window.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            input.focus();
            input.select();
          } else if (e.key === "Escape" && document.activeElement === input) {
            resetSearch();
          } else if (
            e.key === "/" &&
            document.activeElement !== input &&
            !["INPUT", "TEXTAREA"].includes((document.activeElement as HTMLElement)?.tagName)
          ) {
            e.preventDefault();
            input.focus();
          }
        });

        const urlParams = new URLSearchParams(window.location.search);
        const queryFromUrl = urlParams.get("q") || urlParams.get("search");
        if (queryFromUrl) {
          input.value = queryFromUrl;
          performSearch(queryFromUrl);
        }
      }

      document.addEventListener("DOMContentLoaded", initBlogSearch);
      initBlogSearch();
    </script>
  )
}

