---
import { Icon } from "astro-icon/components";
import { getLanguage } from "../../utils/languages";

interface Props {
  lang: string;
  size?: "xs" | "md";
  linkEnabled?: boolean;
}

const { size = "md", lang, linkEnabled = true } = Astro.props as Props;

const selectedLanguage = getLanguage(lang);

const baseClasses = {
  container: [
    "inline-flex items-center w-fit",
    "bg-white/95 dark:bg-zinc-900/90 text-zinc-800 dark:text-zinc-200",
    "border border-zinc-200/90 dark:border-white/10",
    "rounded-full shadow-2xs backdrop-blur-xs",
    "transition-all duration-200 ease-out",
    "hover:border-sunset-400 dark:hover:border-sunset-400/60 hover:bg-sunset-50/70 dark:hover:bg-zinc-800/90 hover:text-sunset-900 dark:hover:text-white hover:scale-[1.04] hover:shadow-xs active:scale-95",
  ].join(" "),
  iconContainer: [
    "flex items-center justify-center shrink-0",
    "aspect-square",
    "bg-zinc-950 dark:bg-black/90 text-white rounded-full shadow-inner",
  ].join(" "),
};

const sizeClasses = {
  xs: {
    container: "px-2 py-0.5 sm:px-2.5 sm:py-1 gap-1 sm:gap-1.5 text-xs font-semibold tracking-tight",
    icon: "size-4 sm:size-4.5 p-0.5",
  },
  md: {
    container: "px-2.5 py-1 sm:px-3 sm:py-1.5 gap-1.5 text-xs sm:text-sm font-semibold tracking-tight",
    icon: "size-5.5 sm:size-6 p-1",
  },
};

const getContainerClasses = () => {
  return `${baseClasses.container} ${sizeClasses[size].container}`;
};

const getIconContainerClasses = () => {
  return `${baseClasses.iconContainer} ${sizeClasses[size].icon} ${
    selectedLanguage.className ? selectedLanguage.className : ""
  }`;
};
---

{
  linkEnabled ? (
    <a
      class="cursor-pointer group/capsule inline-block"
      href={`/blog/techs/${lang}`}
      aria-label={`Ver artigos sobre ${selectedLanguage.name}`}
      role="link"
    >
      <span
        class={getContainerClasses()}
        role="presentation"
        aria-hidden="true"
      >
        <div
          class={getIconContainerClasses()}
          role="img"
          aria-label={`${selectedLanguage.name} icon`}
        >
          <Icon class="w-full! h-full!" name={selectedLanguage.iconName} />
        </div>
        <span class="whitespace-nowrap">{selectedLanguage.name}</span>
      </span>
    </a>
  ) : (
    <span
      class={`${getContainerClasses()} cursor-default select-none`}
      role="presentation"
      aria-hidden="true"
    >
      <div
        class={getIconContainerClasses()}
        role="img"
        aria-label={`${selectedLanguage.name} icon`}
      >
        <Icon class="w-full! h-full!" name={selectedLanguage.iconName} />
      </div>
      <span class="whitespace-nowrap">{selectedLanguage.name}</span>
    </span>
  )
}

