---
import Button from "../ui/Button.astro";
import Heading from "../ui/Heading.astro";
import Tools from "../portfolio/Tools.astro";
import { Icon } from "astro-icon/components";
import Hobbies from "../portfolio/Hobbies.astro";
import ThemeProfileImage from "../ui/ThemeProfileImage.astro";
import { getProfile } from "../../lib/profile";
import type { Profile } from "../../lib/supabase";

interface Props {
  profile?: Profile;
}

const { profile: propProfile } = Astro.props as Props;
const profile = propProfile || (await getProfile());

const {
  profile_alt,
  profile_image,
  profile_name,
  profile_title,
  bio_summary,
  available_for_work,
  email,
  github_url,
  portfolio_image,
  contact_button_text,
} = profile;
---

<section
  class="scroll-m-16 px-8 max-sm:px-4 py-8"
  id="home"
  aria-label="Perfil profissional e introdução"
>
  <div
    class="mx-auto mb-4 h-96 w-full max-w-7xl rounded-2xl bg-linear-to-r from-sunset-300 dark:from-fire-600 to-sunset-50 dark:to-fire-200/5 hover:to-sunset-300/30 dark:hover:to-fire-600/30 p-[.2rem] max-md:h-auto"
  >
    <div
      class="group relative z-0 flex h-full items-center justify-center gap-8 overflow-hidden rounded-2xl bg-linear-to-tr from-fire-100 to-sunset-50 p-4 transition-all hover:shadow-[0_10px_50px_rgba(251,146,60,1)] dark:bg-linear-to-r dark:from-fire-950 dark:to-zinc-950 dark:overflow-hidden max-md:w-full max-md:gap-3 max-lg:gap-2 max-sm:flex-col dark:before:bg-[radial-gradient(circle,rgb(251,146,60)_0,rgba(194,65,12,1)_100%)] before:bg-[radial-gradient(circle,rgba(251,146,60,1)_0,rgba(251,146,60,1)_100%)] before:absolute before:left-65 before:top-10 before:h-[40%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-80 before:-z-10 before:transition hover:before:animate-pulse"
    >
      <div class="aspect-square h-4/5 max-md:size-32">
        <div
          class="group-hover:scale-105 relative z-10 flex w-full cursor-pointer items-center overflow-hidden rounded-full p-[2px] transition-all duration-500"
        >
          <div
            class="absolute inset-0 h-full w-full rounded-full from-transparent to-fire-500 dark:from-transparent dark:to-sunset-300 animate-rotate-border bg-conic/[from_var(--border-angle)]"
          >
          </div>
          <div class="relative z-20 flex w-full rounded-full bg-fire-900">
            <ThemeProfileImage
              lightImage={profile.profile_image_light || profile_image || "/profile-light.png"}
              darkImage={profile.profile_image_dark || profile_image || "/profile-dark.png"}
              alt={profile_alt}
              class="w-full aspect-square"
              shape="rounded-full"
              link="/about-me"
              linkAriaLabel="Ver página sobre mim"
            />
          </div>
        </div>
      </div>

      <div
        class="flex h-full w-7/12 flex-col justify-center gap-4 p-4 max-md:w-full max-md:gap-2"
      >
        {
          available_for_work && (
            <span
              class="relative inline-flex items-center text-xs font-semibold leading-0 dark:text-white text-blacktext max-md:font-medium max-sm:justify-center"
            >
              <span
                class="before:mr-2 before:block before:h-1.5 before:w-1.5 before:rounded-full before:bg-orange-400 before:shadow-[0px_0px_0px_3px_rgba(251,146,60,0.5)] before:animate-pulse before:content-['']"
              ></span>
              Disponível para trabalho
            </span>
          )
        }

        <h1
          class="text-4xl font-black leading-none text-blacktext dark:text-white max-xl:text-3xl max-lg:text-2xl max-sm:text-center"
        >
          {profile_name} 👋
        </h1>
        <p
          class="mb-0 text-lg font-semibold leading-8 text-blacktext dark:text-gray-200 max-xl:text-base"
        >
          <span
            class="bg-linear-to-r from-fire-500 to-sunset-500 bg-clip-text font-black text-transparent dark:from-fire-300 dark:to-sunset-200"
            >{profile_title}</span
          > - {bio_summary}
        </p>

        <div class="flex gap-4 max-sm:flex-col max-sm:items-center">
          <Button
            link={"mailto:" + email}
            text={contact_button_text || "Fale Comigo"}
            iconName="envelope"
          />
          <Button
            link="/about-me"
            text="Sobre Mim"
            iconName="person"
            variant="dark"
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="mx-auto grid max-w-7xl grid-cols-1 sm:grid-cols-2 md:grid-cols-4 md:grid-rows-2 gap-4 max-sm:gap-3.5 h-auto md:h-[580px] lg:h-[620px] xl:h-[680px]"
  >
    <!-- Projetos -->
    <div
      class="col-span-1 sm:col-span-2 md:col-span-2 md:row-span-2 md:col-start-1 md:row-start-1 rounded-2xl bg-linear-to-r from-sunset-300 dark:from-fire-600 to-sunset-50 dark:to-fire-200/5 p-[.2rem] hover:to-sunset-300/30 dark:hover:to-fire-600/30 transition-all duration-300 hover:scale-[1.01]"
    >
      <article
        class="group relative flex h-full flex-col justify-between overflow-hidden rounded-2xl bg-linear-to-br from-fire-100 to-sunset-50 dark:from-fire-950 dark:to-zinc-950 p-6 sm:p-8 transition-all hover:shadow-[0_20px_50px_rgba(251,146,60,0.4)] dark:before:bg-[radial-gradient(circle,rgb(251,146,60)_0,rgba(194,65,12,1)_100%)] before:bg-[radial-gradient(circle,rgba(251,146,60,1)_0,rgba(251,146,60,1)_100%)] before:absolute before:left-1/2 before:bottom-30 before:h-[30%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-70 before:transition before:-z-0 hover:before:animate-pulse xl:before:bottom-2/5"
      >
        <a
          href="#projects"
          class="absolute left-0 top-0 z-40 h-full w-full bg-transparent"
          aria-label="Ver seção de projetos"></a>
        <div>
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center size-9 sm:size-10 rounded-xl bg-sunset-500/10 dark:bg-fire-500/15 text-sunset-500 dark:text-sunset-300 border border-sunset-500/20 shadow-2xs">
              <Icon
                class="size-5 sm:size-6"
                name="code"
                aria-hidden="true"
              />
            </div>
            <Heading text="Projetos" level={3} />
          </div>
          <p
            class="z-2 my-4 sm:my-6 text-base sm:text-lg font-semibold leading-relaxed dark:text-gray-200 text-blacktext max-w-[92%]"
          >
            Adoro <span
              class="bg-linear-to-r from-fire-500 to-sunset-500 bg-clip-text font-black text-transparent dark:from-fire-300 dark:to-sunset-200"
              >transformar ideias em projetos reais.</span
            >
            <br /> Aqui apresento alguns dos <span
              class="bg-linear-to-r from-fire-500 to-sunset-500 bg-clip-text font-black text-transparent dark:from-fire-300 dark:to-sunset-200"
              >desenvolvimentos</span
            > em que trabalhei, aplicando tecnologia, design e muita criatividade.
            <span
              class="bg-linear-to-r from-fire-500 to-sunset-500 font-black bg-clip-text text-transparent dark:from-fire-300 dark:to-sunset-200"
              >Confira!</span
            >
          </p>
        </div>
        <div class="relative overflow-hidden rounded-xl mt-2 flex items-center justify-center">
          <img
            class="w-full object-cover rounded-xl transition-all ease-in-out duration-500 group-hover:scale-105"
            src={portfolio_image}
            alt="Visualização de interfaces de projetos desenvolvidos."
            loading="lazy"
            width="480"
            height="320"
          />
        </div>
      </article>
    </div>

    <!-- Tech Stack -->
    <div
      class="col-span-1 sm:col-span-2 md:col-span-2 md:col-start-3 md:row-start-1 rounded-2xl bg-linear-to-r from-sunset-300 dark:from-fire-600 to-sunset-50 dark:to-fire-200/5 hover:to-sunset-300/30 dark:hover:to-fire-600/30 p-[.2rem] transition-all duration-300 hover:scale-[1.01] hover:shadow-[0_12px_40px_rgba(251,146,60,0.35)]"
    >
      <article
        class="group relative z-0 flex h-full w-full flex-col justify-between overflow-hidden rounded-2xl bg-linear-to-tr from-fire-100 to-sunset-50 p-6 dark:bg-linear-to-br dark:from-zinc-950 dark:via-zinc-900 dark:to-fire-950/40 dark:overflow-hidden max-md:p-5 gap-4 dark:before:bg-[radial-gradient(circle,rgb(251,146,60)_0,rgba(194,65,12,1)_100%)] before:bg-[radial-gradient(circle,rgba(251,146,60,1)_0,rgba(251,146,60,1)_100%)] before:absolute before:left-30 before:-bottom-0 before:h-[80%] before:aspect-square before:rounded-full before:blur-3xl dark:before:opacity-80 before:opacity-30 before:-z-10 before:transition"
      >
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center size-9 sm:size-10 rounded-xl bg-sunset-500/10 dark:bg-fire-500/15 text-sunset-500 dark:text-sunset-300 border border-sunset-500/20 shadow-2xs">
              <Icon class="size-5 sm:size-6" name="dashboard" aria-hidden="true" />
            </div>
            <Heading text="Tech" textGradient="Stack" level={3} />
          </div>
        </div>

        <div class="overflow-y-auto max-h-[170px] sm:max-h-[190px] md:max-h-[200px] lg:max-h-[230px] pr-1 scrollbar-thin scrollbar-thumb-sunset-500/30 scrollbar-track-transparent">
          <Tools />
        </div>
      </article>
    </div>

    <!-- GitHub Repo Card -->
    <div
      class="col-span-1 sm:col-span-1 md:col-span-1 md:col-start-3 md:row-start-2 rounded-2xl bg-linear-to-r from-sunset-300 dark:from-fire-600 to-sunset-50 dark:to-fire-200/5 hover:to-sunset-300/30 dark:hover:to-fire-600/30 p-[.2rem] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_20px_50px_rgba(251,146,60,0.35)] z-10"
    >
      <div class="h-full w-full overflow-hidden rounded-2xl dark:bg-zinc-900">
        <div
          class="relative h-full w-full overflow-hidden rounded-2xl bg-linear-to-tr from-fire-100 to-sunset-50 dark:from-transparent dark:bg-linear-to-bl dark:to-transparent"
        >
          <a
            target="_blank"
            href={github_url}
            aria-label="Ver repositório deste site no GitHub"
            class="block h-full w-full"
          >
            <div
              class="group relative flex h-full flex-col justify-between p-6 max-md:p-5 dark:before:bg-[radial-gradient(circle,rgb(251,146,60)_0,rgba(194,65,12,1)_100%)] before:bg-[radial-gradient(circle,rgba(251,146,60,1)_0,rgba(251,146,60,1)_100%)] before:absolute before:left-30 before:bottom-30 before:h-[30%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-90 before:transition before:z-0 xl:before:bottom-10"
            >
              <div class="z-2">
                <Heading text="Gostou do design deste site?" level={3} />
              </div>

              <div class="flex items-center justify-between mt-auto pt-2 z-2">
                <span class="text-xs font-semibold text-sunset-600 dark:text-sunset-300 group-hover:underline">Ver no GitHub →</span>
              </div>

              <Icon
                class="absolute -bottom-8 -right-8 size-36 sm:size-44 text-sunset-500/20 dark:text-sunset-500/15 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 pointer-events-none"
                name="github"
                aria-hidden="true"
              />
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Além do Código -->
    <div
      class="col-span-1 sm:col-span-1 md:col-span-1 md:col-start-4 md:row-start-2 rounded-2xl bg-linear-to-r from-sunset-300 dark:from-fire-600 to-sunset-50 dark:to-fire-200/5 hover:to-sunset-300/30 dark:hover:to-fire-600/30 p-[.1rem] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_12px_40px_rgba(251,146,60,0.35)]"
    >
      <article
        class="group relative z-0 flex h-full w-full flex-col justify-between overflow-hidden rounded-2xl bg-linear-to-tr from-fire-100 to-sunset-50 p-6 dark:bg-linear-to-br dark:from-zinc-950 dark:via-zinc-900 dark:to-fire-950/40 dark:overflow-hidden max-md:p-5 gap-3 dark:before:bg-[radial-gradient(circle,rgb(251,146,60)_0,rgba(194,65,12,1)_100%)] before:bg-[radial-gradient(circle,rgba(251,146,60,1)_0,rgba(251,146,60,1)_100%)] before:absolute before:-right-10 before:-bottom-10 before:size-44 before:aspect-square before:rounded-full before:blur-3xl dark:before:opacity-80 before:opacity-30 before:-z-10 before:transition"
      >
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-3">
            <Heading text="Além do" textGradient="Código" level={3} />
          </div>
        </div>
        <div class="overflow-y-auto pr-1 scrollbar-thin scrollbar-thumb-sunset-500/30 scrollbar-track-transparent">
          <Hobbies />
        </div>
      </article>
    </div>
  </div>
</section>
