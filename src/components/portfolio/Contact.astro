---
import Heading from "../ui/Heading.astro";
import Button from "../ui/Button.astro";
import { getProfile } from "../../lib/profile";

const profile = await getProfile();
const contactSectionTitle = profile.contact_title || "Quer transformar dados em insights?";
const contactSectionSubtitle = profile.contact_subtitle || "Vamos conversar!";
const contactSectionButtonText = profile.contact_button_text || "Fale Comigo";
const email = profile.email || "bernardonogueira8@hotmail.com";
const contactSectionButtonIcon = "paperplane";
---

<section>
  <div
    class="w-full border-b bg-linear-to-b from-mint-100 to-transparent dark:from-mint-800 dark:border-mint-950 border-mint-100"
  >
    <div class="mx-auto max-w-5xl px-8 py-24 max-sm:py-12">
      <div
        class="flex items-center justify-between max-sm:flex-col max-sm:gap-8 max-sm:text-center"
      >
        <div class="max-w-lg">
          <Heading
            text={contactSectionTitle}
            textGradient={contactSectionSubtitle}
            level={2}
          />
        </div>
        <div
          class="transition-all duration-500 group-hover:animate-jump group-hover:animate-duration-[300ms] group-hover:animate-ease-in-out group-hover:scale-105 hover:scale-125"
        >
          <Button
            variant="big"
            link={`mailto:${email}`}
            text={contactSectionButtonText}
            iconName={contactSectionButtonIcon}
          />
        </div>
      </div>
    </div>
  </div>
</section>
