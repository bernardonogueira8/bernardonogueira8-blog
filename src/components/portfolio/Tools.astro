---
import Capsule from "../ui/Capsule.astro";
import { getTechStack } from "../../lib/techStack";

interface Props {
  variant?: "default" | "center";
  linkEnabled?: boolean;
  size?: "xs" | "md";
  tools?: string[];
}

const { variant = "default", linkEnabled = false, size = "md", tools: propTools } = Astro.props as Props;

let allTools: string[] = [];
if (propTools && propTools.length > 0) {
  allTools = propTools;
} else {
  const stack = await getTechStack(true);
  allTools = stack.map((t) => t.key);
}

type ToolVariant = "default" | "center";

// Base classes that are common to all variants
const baseClasses = "flex flex-wrap gap-2 sm:gap-2.5 md:gap-3 items-center content-start";

// Variant-specific classes
const variantClasses: Record<ToolVariant, string> = {
  default: "cursor-default",
  center: "justify-center cursor-default",
};

// Combine base classes with variant-specific classes
const classes = `${baseClasses} ${variantClasses[variant as ToolVariant]}`;
---

<div class={classes}>
  {allTools.map((tool) => <Capsule lang={tool} linkEnabled={linkEnabled} size={size} />)}
</div>
