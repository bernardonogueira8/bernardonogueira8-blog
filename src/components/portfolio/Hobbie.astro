---
interface Props {
  tag: string;
}

const { tag } = Astro.props as Props;
---

<div
  class="group inline-flex items-center gap-2 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-200 bg-white/85 dark:bg-zinc-900/85 border border-sunset-200/60 dark:border-white/10 hover:border-sunset-400 dark:hover:border-sunset-400/50 hover:bg-sunset-50/70 dark:hover:bg-zinc-800/90 shadow-2xs backdrop-blur-xs transition-all duration-200 hover:scale-[1.03] select-none cursor-default"
>
  <span class="tracking-tight">{tag}</span>
</div>

