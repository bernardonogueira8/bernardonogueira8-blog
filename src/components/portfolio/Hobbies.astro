---
import { getProfile } from "../../lib/profile";
import Hobbie from "./Hobbie.astro";

const profile = await getProfile();
const hobbies = profile.hobbies && profile.hobbies.length > 0
  ? profile.hobbies
  : ["Ciência de Dados", "Matemática", "Gastronomia"];

interface Props {
  variant?: "default" | "vertical";
}

const variants = {
  default: "flex flex-wrap items-center justify-start gap-2 sm:gap-2.5",
  vertical: "flex flex-col items-start justify-start gap-2",
} as const;

const { variant = "default" } = Astro.props as Props;
const classes = variants[variant];
---

<div id="tags" class={classes}>
  {hobbies.map((hobby) => <Hobbie tag={hobby} />)}
</div>
