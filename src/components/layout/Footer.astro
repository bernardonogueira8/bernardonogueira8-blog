---
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getProfile } from "../../lib/profile";

const profile = await getProfile();
const github = profile.github_url || "https://github.com/bernardonogueira8";
const alias = profile.alias || "bernardonogueira8";
const instagram = profile.instagram_url || "https://www.instagram.com/bernardo.nogueira8";
const email = profile.email || "bernardonogueira8@hotmail.com";
const youtube = profile.youtube_url || "https://www.youtube.com/channel/UC_Zyyr27x67UaGcHS55rutQ";
const linkedin = profile.linkedin_url || "https://www.linkedin.com/in/bernardonogueira8";
const emailIconName = "envelope";
const youtubeIconName = "youtube";
const linkedinIconName = "linkedin";
const instagramIconName = "instagram";
const githubIconName = "github";
---

<footer
  class="relative bottom-0 w-full px-4 py-8 font-medium text-blacktext dark:bg-transparent dark:border-b-2 dark:border-zinc-800 dark:text-zinc-300 max-lg:mt-3"
  role="contentinfo"
  aria-label="Site footer"
>
  <nav
    class="mx-auto flex max-w-7xl flex-row items-center justify-between gap-4 text-xl max-xl:px-6 max-sm:flex-col"
    aria-label="Footer navigation"
  >
    <div
      class="relative h-6 cursor-pointer before:absolute before:left-1/2 before:top-1/2 before:h-full before:w-[40%] before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-[#ea580c] before:blur-3xl before:opacity-80 before:-z-1 hover:text-mint-500 transition-all [text-shadow:0_1px_2px_#000]"
    >
      <a href="/" aria-label="Return to homepage">
        <!-- This icon represents the logo -->
        <Icon name="logo" aria-hidden="true" />
      </a>
    </div>
    <div class="text-center flex flex-col sm:flex-row items-center justify-center gap-2 text-base font-normal italic max-sm:text-sm">
      <a
        href={github}
        class="flex items-center justify-center gap-3"
        aria-label="Sobre o desenvolvimento do site"
        ><Icon name="code" aria-hidden="true" /> Adaptado de EFEELE/NeonMint
        <strong>{alias}</strong></a
      >
      <span class="hidden sm:inline text-neutral-400">•</span>
      <a href="/admin" class="text-xs text-neutral-400 hover:text-mint-400 transition-colors not-italic font-medium">
        Studio Admin
      </a>
    </div>
    <div
      class="flex items-center justify-center gap-5"
      role="group"
      aria-label="Social media links"
    >
      <Social
        link={`mailto:${email}`}
        iconName={emailIconName}
        label={`Send email to ${email}`}
      />
      <Social
        link={instagram}
        iconName={instagramIconName}
        label={`Visit ${alias} on Instagram`}
      />
      <Social
        link={youtube}
        iconName={youtubeIconName}
        label={`Visit ${alias} on YouTube`}
      />
      <Social
        link={github}
        iconName={githubIconName}
        label={`Visit ${alias} on GitHub`}
      />
      <Social
        link={linkedin}
        iconName={linkedinIconName}
        label={`Visit ${alias} on LinkedIn`}
      />
    </div>
  </nav>
</footer>
