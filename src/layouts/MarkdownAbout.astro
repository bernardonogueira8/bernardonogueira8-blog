---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import Heading from "../components/ui/Heading.astro";
import Experience from "../components/portfolio/Experience.astro";
import NavArticle from "../components/layout/NavArticle.astro";
import Contact from "../components/portfolio/Contact.astro";
import Tools from "../components/portfolio/Tools.astro";
import ThemeProfileImage from "../components/ui/ThemeProfileImage.astro";
import { getProfile } from "../lib/profile";

const { frontmatter } = Astro.props;
const profile = await getProfile();

const pageTitle = frontmatter?.title || profile.about_title || "Sobre Mim | Bernardo Nogueira";
const pageDescription = frontmatter?.description || profile.about_description || profile.page_description;
const profileImage = profile.profile_image || "/profile.png";
const profileName = profile.profile_name || "Bernardo Nogueira";
const headline = profile.headline || "Data Scientist & Math Teacher apaixonado por tecnologia, educação e ciência.";
---

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach((header) => {
      header.classList.add("scroll-m-28");
    });
  });
</script>

<Layout
  pageTitle={pageTitle}
  description={pageDescription}
  ogimage={{ url: profileImage, alt: `Foto de ${profileName}` }}
>
  <section
    class="w-full px-8 mt-5 max-sm:px-4 py-4 flex flex-row justify-center gap-6"
  >
    <div class="w-64 max-xl:hidden"></div>

    <article
      class="flex flex-col gap-8 max-w-3xl max-md:w-full pb-10 pt-8 mt-8 max-sm:mt-0 px-14 max-md:px-10 max-sm:px-6 dark:bg-transparent bg-white dark:border-0 border border-neutral-100 rounded-2xl"
    >
      <div class="w-full h-auto mb-4 mx-auto" id="#">
        <div
          class="transition-all justify-center w-full gap-8 max-md:gap-3 max-lg:gap-2 flex flex-col items-center z-0 relative dark:from-fire-950 dark:to-zinc-950"
        >
          <div class="aspect-square h-60 max-md:size-32">
            <div
              class="group-hover:scale-105 relative z-10 flex w-full cursor-pointer items-center overflow-hidden rounded-full dark:p-[1.5px] p-[2px] transition-all duration-500"
            >
              <div
                class="absolute inset-0 h-full w-full rounded-full from-transparent to-sunset-500 dark:from-transparent dark:to-fire-300 animate-rotate-border bg-conic/[from_var(--border-angle)]"
              >
              </div>
              <div class="relative z-20 flex w-full rounded-full bg-fire-900">
                <ThemeProfileImage
                  lightImage={profile.profile_image_light || profileImage || "/profile-light.png"}
                  darkImage={profile.profile_image_dark || profileImage || "/profile-dark.png"}
                  alt={`Foto de ${profileName}`}
                  class="w-full aspect-square"
                  shape="rounded-full"
                />
              </div>
            </div>
          </div>

          <div class="w-full flex flex-col justify-center gap-4 max-md:gap-2">
            <div class="text-center">
              <Heading textGradient={profileName} />
            </div>

            <p
              class="text-lg max-xl:text-base text-blacktext dark:text-gray-200 mb-0 leading-8 font-semibold text-center"
            >
              {headline}
            </p>
          </div>
        </div>
      </div>

      <div class="flex gap-4 items-center">
        <Heading text="Sobre" textGradient="Mim" />
      </div>

      <div class="markdown text-neutral-800 dark:text-neutral-200 leading-relaxed space-y-4" id="content">
        <slot />
      </div>
    </article>
    <NavArticle title={pageTitle} />
  </section>

  <section class="py-8 px-8 max-md:py-4 mb-4 scroll-m-16" id="experience">
    <div class="flex flex-col gap-8 pt-8 max-w-4xl mx-auto">
      <Experience />
    </div>
  </section>

  <section class="py-8 px-8 max-md:py-4 mt-10 mb-20 scroll-m-16" id="stack">
    <div class="flex flex-col gap-8 max-w-3xl justify-center mx-auto">
      <div class="flex gap-4 items-center justify-center">
        <Icon class="text-3xl text-white" name="dashboard" />
        <Heading text="Stack" textGradient="Tecnológica" level={2} />
      </div>
      <Tools variant="center" />
    </div>
  </section>

  <Contact />
</Layout>
